        "environment variables",
        "monitoring"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "kreisvier communications AG",
            "homepage": "https://www.kreisvier.ch"
        },
        {
            "name": "Mischa Sprecher",
            "homepage": "https://www.marukka.ch"
        }
    ],
    "support": {
        "email": "",
        "issues": "",
        "source": "",
        "docs": ""
    },
    "require": {
