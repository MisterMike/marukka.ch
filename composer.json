{
  "require": {
    "craftcms/cms": "3.4.1",
    "vlucas/phpdotenv": "^2.4.0",
    "barrelstrength/sprout-notes": "^v2.2.3",
    "craftcms/redactor": "^2.3.1",
    "ether/logs": "^v3.0.0",
    "aelvan/preparse-field": "^1.0",
    "supercool/buttonbox": "^2.0",
    "marionnewlevant/picture": "^2.2",
    "verbb/default-dashboard": "^1.0",
    "wrav/oembed": "^1.1.6",
    "smalot/pdfparser": "^0.14.0",
    "k4/k4navigation": "^2.2",
    "k4/k4encodeemails": "^2.1",
    "k4/k4-image-optimizer": "dev-master",
    "cebe/markdown": "~1.1.0",
    "superbig/craft3-templateselect": "^2.0",
    "carlcs/craft-redactorcustomstyles": "^3.0",
    "vaersaagod/matrixmate": "^1.2.0",
    "vaersaagod/seomate": "^1.0",
    "craftcms/contact-form": "^2.2.5",
    "craftcms/contact-form-honeypot": "^1.0",
    "spatie/pdf-to-text": "^1.2",
    "voku/portable-utf8": "^5.4",
    "nibiru/facebook-events":"^0.1",
    "codemonauts/craft-instagram-feed": "^1.0",
    "craftcms/element-api": "2.6.0",
    "craftcms/feed-me": "4.1.2",
    "craftcms/commerce": "3.0.3"

  },
  "autoload": {
    "psr-4": {
      "modules\\k4pdfextractormodule\\": "modules/k4pdfextractormodule/src/",
      "modules\\k4twigextensionsmodule\\": "modules/k4twigextensionsmodule/src/",
      "modules\\k4sitemodule\\": "modules/k4sitemodule/src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "7.2"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "dev/_plugins/*",
      "options": {
        "symlink": true
      }
    }
  ],
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-install-cmd": [
      "./dev/_scripts/start.sh"
    ]
  },
  "prefer-stable": true,
  "require-all": true
}
