{
    "require": {
        "besteadfast/craft-preparse-field": "2.0.2",
        "carlcs/craft-redactorcustomstyles": "4.0.3",
        "charliedev/section-field": "2.0",
        "craftcms/ckeditor": "3.7.3",
        "craftcms/cms": "^5.0.0",
        "craftcms/element-api": "3.0.1.1",
        "furbo/cache-builder": "^1.0",
        "k4/k4-cache-warmer": "^2.0",
        "k4/k4-complianz": "^2.0",
        "k4/k4-forms": "^2.0",
        "k4/k4-healthcheck": "^2.0",
        "k4/k4-notes": "^4.0",
        "k4/k4encodeemails": "^2.3",
        "k4/k4navigation": "^3.0",
        "mischa-sprecher/craft-test": "dev-master",
        "nystudio107/craft-autocomplete": "^1.0",
        "statikbe/craft-config-values": "2.0.2",
        "studioespresso/craft-dumper": "3.0.1",
        "superbig/craft3-templateselect": "^3.0",
        "symfony/translation-contracts": "^2.4",
        "vaersaagod/assetmate": "^2.1",
        "vaersaagod/matrixmate": "2.1.4",
        "vaersaagod/seomate": "2.2.0",
        "verbb/buttonbox": "4.2.0",
        "verbb/kint": "^3.1",
        "vlucas/phpdotenv": "^5",
        "voku/portable-utf8": "6.0.13",
        "webdna/qrcode": "^2.0",
        "wrav/oembed": "3.0.7",
        "yiisoft/yii2-shell": "^2.0"
    },
    "require-dev": {
        "craftcms/generator": "^1.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "modules\\k4pdfextractormodule\\": "modules/k4pdfextractormodule/src/",
            "modules\\k4twigextensionsmodule\\": "modules/k4twigextensionsmodule/src/",
            "modules\\k4sitemodule\\": "modules/k4sitemodule/src/",
            "modules\\": "modules/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://bitbucket.org/kreisvierdigital/k4notes.git"
        },
        {
            "type": "vcs",
            "url": "https://bitbucket.org/kreisvierdigital/k4cachewarmer.git"
        },
        {
            "type": "vcs",
            "url": "https://bitbucket.org/kreisvierdigital/k4forms.git"
        },
        {
            "type": "vcs",
            "url": "https://bitbucket.org/kreisvierdigital/k4complianz.git"
        },
        {
            "type": "path",
            "url": "./src/plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "composer",
            "url": "https://composer.craftcms.com",
            "canonical": false
        }
    ],
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}