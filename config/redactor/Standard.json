{
  "buttons": ["html", "alignment", "formatting", "bold", "italic","small", "unorderedlist", "orderedlist", "link", "image", "file", "video", "table"],
  "plugins": ["video","table","customstyles","alignment"],
  "formatting": ["p","pre", "h2", "h3", "h4"],
  "linkNewTab": true,
  "toolbarFixed": true,
  "customStyles": {
    "style": {
      "dropdown": {
        "hochgestellt": {
          "args": "sup"
        },
        "tiefgestellt": {
          "args": "sub"
        },
        "zitat": {
          "args": "q"
        },
        "gross": {
          "args": "big"
        },
        "klein": {
          "args": "small"
        },
        "Style löschen": {
          "api": "module.inline.clearformat"
        }
      }
    }
  }
}