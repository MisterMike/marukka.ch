{
  "require": {
    "craftcms/cms": "^3.1.27",
    "vlucas/phpdotenv": "^2.4.0",
    "barrelstrength/sprout-notes": "v2.2.3",
    "doublesecretagency/craft-cpjs": "^2.1.0",
    "craftcms/redactor": "^2.3.1",
    "ether/logs": "v3.0.0",
    "lucasbares/craft-emailobfuscator": "^2.1.0",
    "doublesecretagency/craft-cpcss": "^2.1.0",
    "aelvan/preparse-field": "^1.0",
    "supercool/buttonbox": "^2.0",
    "marionnewlevant/picture": "^2.2",
    "verbb/default-dashboard": "^1.0",
    "wrav/oembed": "^1.1.6",
    "smalot/pdfparser": "^0.14.0",
    "k4/k4navigation": "^2.0",
    "k4/k4poweradmin": "^2.0",
    "cebe/markdown": "~1.1.0",
    "superbig/craft3-templateselect": "^2.0",
    "k4/k4-image-optimizer": "dev-master",
    "carlcs/craft-redactorcustomstyles": "^3.0",
    "vaersaagod/matrixmate": "^1.1",
    "mildlygeeky/craft-kint": "1.0.0",
    "vaersaagod/seomate": "^1.0",
    "craftcms/contact-form": "2.2.4",
    "craftcms/contact-form-honeypot": "^1.0",
    "spatie/pdf-to-text": "^1.2",
    "voku/portable-utf8": "^5.4",
    "nibiru/weather-station-data": "^1.0.0"
  },
  "autoload": {
    "psr-4": {
      "modules\\k4pdfextractormodule\\": "modules/k4pdfextractormodule/src/",
      "modules\\litespeedclearcachemodule\\": "modules/litespeedclearcachemodule/src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "7.0"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url":  "https://kreisvier@bitbucket.org/kreisvierdigital/k4navigationcraft3.git"
    },
    {
      "type": "vcs",
      "url":  "https://kreisvier@bitbucket.org/kreisvierdigital/k4poweradmincraft3.git"
    },
    {
      "type": "path",
      "url": "dev/_plugins/*",
      "options": {
            "symlink": true
        }
    }
  ], "require-all": true
}
