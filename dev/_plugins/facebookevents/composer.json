{
    "name": "nibiru/facebook-events",
    "description": "A Simple Plugin to load Facebook Events using Graph SDK",
    "type": "craft-plugin",
    "version": "0.1.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "facebookevents"
    ],
    "support": {
        "docs": "https://github.com/",
        "issues": "https://github.com/"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mischa Sprecher",
            "homepage": "https://parhelia.ch"
        }
    ],
    "require": {
        "facebook/graph-sdk": "^5.7"
    },
    "autoload": {
        "psr-4": {
          "nibiru\\facebookevents\\": "src/"
        }
    },
    "extra": {
        "name": "FacebookEvents",
        "handle": "facebook-events",
        "hasCpSettings": true,
        "hasCpSection": false,
        "changelogUrl": "https://raw.githubusercontent.com/Test Facebook/facebook-events/master/CHANGELOG.md",
        "components": {
            "facebookEventsService": "nibiru\\facebookevents\\services\\FacebookEventsService"
        },
        "class": "nibiru\\facebookevents\\FacebookEvents"
    }
}
