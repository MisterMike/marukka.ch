{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("nibiru\\facebookevents\\assetbundles\\facebookevents\\FacebookEventsAsset") %}

<p>All settings are required!</p>

{{ forms.textField({
  label: "Facebook App Id",
  name: "facebookAppId",
  required: "true",
  value: settings['facebookAppId']
}) }}

{{ forms.textField({
  label: "Facebook Secret",
  name: "facebookSecret",
  required: "true",
  value: settings['facebookSecret']
}) }}

{{ forms.textField({
  label: "Facebook Page Name",
  name: "facebookPage",
  required: "true",
  value: settings['facebookPage']
}) }}

{{ forms.textField({
label: "Facebook Permanent Access Token",
name: "facebookAccessToken",
required: "true",
value: settings['facebookAccessToken']
}) }}

{{ forms.textField({
  label: "Filter Time (upcoming/past)",
  name: "facebookFilter",
  required: "true",
  value: settings['facebookFilter']
}) }}

{{ forms.lightswitchField({
  label: "Show past events",
  instructions: "Whether past events should be showed (default is upcoming)",
  name: 'facebookFilter',
  on: settings['facebookFilter'],
  required: true,
}) }}