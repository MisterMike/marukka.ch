{
  "private": true,
  "name": "craft-grid",
  "description": "Craft grid Template for Craft CMS 3.x",
  "version": "3.3.0",
  "main": "/public/index.php",
  "repository": {
    "type": "git",
    "url": "https://kreisvier@bitbucket.org/kreisvier/default-craft-template.git"
  },
  "keywords": [],
  "author": "kreisvier Communications AG, Basel (Switzerland)",
