{% set relatedSections = block.channelSection %}    
{% set sectionEntries = craft.entries.sectionId(relatedSections) %}

<section class="l-section gallery-teaser akzent-{{ block.akzent|default('neutral') }}" id="section-{{block.id}}">
    <div class="l-container l-grid l-grid--singlecol">
        <div class="l-grid l-grid__region l-grid__region--singlecol">
            <div class="l-module l-image">

                <div class="m-small-teaser m-small-teaser--list">

                    <div class="m-small-teaser__wrapper l-grid">


                    {%- for item in sectionEntries -%}

                    {%- set image = item.hero.one() | default() -%}

                    {% if item.kategorie|length %}
                        {% set categories = item.kategorie|map((value) => "<span class='badge bg-grey text-white'>#{value}</span>")|join(' ')|raw %}
                    {% else %}
                        {% set categories = '' %}
                    {% endif %}

                    {% include '_blocks/smallTeaser' with {
                            topline: categories,
                            url: item.url,
                            bild: image,
                            bildBreite: 480,
                            bildHoehe: 480,
                            transformMode: 'fit',
                            titel:item.title,
                            content: item.lead|default(),
                            buttons: 1
                        }
                    %}

                    {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>