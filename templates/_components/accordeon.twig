

 {% if block.inhalt|length %}

  {% if ueberschrift is not defined %}
    {% set ueberschrift = false %}
  {% endif %}

  {% if prevType != 'accordeon' and prevType != 'ueberschrift' %}

    {% set ueberschrift = true %}

    <article id="accordeon__{{ block.fieldId }}" class="accordeon__wrapper">
      <div class="container">
        
  {% endif %}

        <div class="accordeon__item" id="accordeon-{{ block.id }}">
          <h3 class="accordeon__item--title">
          <svg aria-hidden="true" focusable="false" data-icon="angle-right" class="svg--inline" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512"><path fill="currentColor" d="M224.3 273l-136 136c-9.4 9.4-24.6 9.4-33.9 0l-22.6-22.6c-9.4-9.4-9.4-24.6 0-33.9l96.4-96.4-96.4-96.4c-9.4-9.4-9.4-24.6 0-33.9L54.3 103c9.4-9.4 24.6-9.4 33.9 0l136 136c9.5 9.4 9.5 24.6.1 34z"></path></svg>
          {{ block.titel }}</h3>
          <div class="accordeon__item--content">{{ block.inhalt }}</div>
        </div>

    {% if nextType != 'accordeon' %}
      
    </div></article>
    {{ ueberschrift ? '</div></div></section>' : '' }}

  {% endif %}

 {% endif %}