{% set featuredEntries = block.eintraege.all() %}

<section class="block-featured-content-3-columns" id="featured-content-1">
	<div class="block-featured-content-3-columns__inner">
		<div class="featured-content">

			{% if block.titel|length %}
			<h2 class="featured-content__title">{{ block.titel }}</h2>
			{% endif %}

			<div class="featured-content__content">
				<ul class="featured-content__itemlist">

					{% for item in featuredEntries %}

					{% set image = item.hero.one() | default() %}

					  {% if image.hasFocalPoint %}
					    {% set focalPoint = image.getFocalPoint() %}
					    {% set position = focalPoint.x * 100 ~ '% ' ~ focalPoint.y * 100 ~ '%' %}
					  {% else %}
					    {% set position = 'center center' %}
					  {% endif %}

					<li class="featured-content__item">
						<a class="featured-content__link" href="{{ item.url() }}">
							<figure class="featured-content__image">
								<picture>
									<source 
										sizes="(min-width: 900px) 25vw, (min-width: 600px) 40vw, calc(100vw - 52px)"
						                srcset="{{ image.url({ width: 372, height: 240, format: 'webp' }) }} 372w,
						            {{ image.url({ width: 558, height: 360, format: 'webp' }) }} 558w,
						            {{ image.url({ width: 744, height: 480, format: 'webp' }) }} 744w" 
						                type="image/webp">
									<source 
										sizes="(min-width: 900px) 25vw, (min-width: 600px) 40vw, calc(100vw - 52px)"
						                srcset="{{ image.url({ width: 372, height: 240 }) }} 372w,
						            {{ image.url({ width: 558, height: 360 }) }} 558w,
						            {{ image.url({ width: 744, height: 480 }) }} 744w" 
						                type="image/jpeg">
									
									<img src="{{ image.url({ width: 372, height: 240 }) }}" alt="{{image.assetAltText|default(image.title)}}" style="object-position: {{position}}" loading="lazy">
								</picture>
							</figure>

							<div class="featured-content__body">
								<h3 class="featured-content__body--title">{{ item.title|default() }}</h3>

								<div class="featured-content__body--description">
									<p>{{ item.teaser|default() }}</p>
								</div>

								<span class="featured-content__body--readmore">
									<span>{{ 'Mehr lesen' | t }}</span>
									<svg xmlns="http://www.w3.org/2000/svg" width="17" height="12.61" viewBox="0 0 17 12.61" fill="currentColor"><path d="M16.71,5.6,11.11,0,9.69,1.41l3.9,3.9H0v2H13.59L9.69,11.2l1.42,1.41L16.71,7A1,1,0,0,0,16.71,5.6Z"></path></svg>
								</span>
							</div>
						</a>
					</li>

					{% endfor %}

				</ul>
			</div>
		</div>
	</div>
</section>