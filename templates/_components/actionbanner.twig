{% if block.actionBanner is defined %}

  {% set linkhref = '' %}
  {% set targetblank = false %}

  {% if block.internerLink|length %}

      {% for linkItem in block.internerLink.all() %}

          {% set linkhref = linkItem.url %}

      {% endfor %}

  {% elseif block.externerLink|length %}

      {% set linkhref = block.externerLink %}
      {% if "@" in linkhref %}
          {% set linkhref="mailto:" ~ linkhref | replace("mailto:","") %}
      {% endif%}
      {% set targetblank = true %}

  {% elseif block.linkZuDatei|length %}

      {% for linkItem in block.linkZuDatei.all() %}

          {% set linkhref = linkItem.url %}
          {% set targetblank = true %}

      {% endfor %}

  {% endif %}


  {% set fullLink %}
      <a class="actionbanner__button--link" href="{{ linkhref }}" {% if targetblank %}target="_blank"{% endif %}>
          <span class="button button--invers button--small">{{ block.buttonText }}<i class="icon-right-open"></i></span>
      </a>
  {% endset %}

<section class="actionbanner__section">
    <div class="actionbanner__wrapper">



        <div class="col-2 ">
            &nbsp;
        </div>

        <div class="col-7 ">
            <div class="actionbanner__content" data-sal="slide-right" data-sal-duration="500" data-sal-easing="ease-in-out">
                <h3 class="actionbanner__title">{{ block.titel }}</h3>
                <p class="actionbanner__text">{{ block.text }}</p>
            </div>
        </div>

        <div class="col-3 ">
            {% if linkhref|length %}
                {% set fullLink %}
                    <a class="actionbanner__button--link" href="{{ linkhref }}" {% if targetblank %}target="_blank"{% endif %}>
                        <span class="button button--invers button--small">{{ block.buttonText }}<i class="icon-right-open"></i></span>
                    </a>
                {% endset %}

                <div class="actionbanner__button" data-sal="slide-left" data-sal-duration="500" data-sal-easing="ease-in-out">
                    {{  fullLink | encodeEmails | raw }}
                </div>

            {% endif %}

        </div>

    </div>
</section>

{% endif %}