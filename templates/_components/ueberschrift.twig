{% if block.titel|length %}
  <section id="{{ block.id }}" class="container">
    <header class="section-heading">
      <{{ block.ueberschriftstyp | default("h2") }} id="{{ block.titel|ascii|replace(' ', '-') }}">{{ block.titel }}</{{ block.ueberschriftstyp | default("h2") }}>
    </header>
  </section>
{% endif %}

