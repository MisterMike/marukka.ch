{%- set hasTitle = block.titel != '' ? 1 : 0 %}
{% set ueberschriftTyp = block.ueberschriftTyp ? block.ueberschriftTyp : "h3" -%}

<section class="l-section title akzent-neutral">

{%- if hasTitle -%}

<div class="l-container">
    <div class="l-grid l-grid--singlecol">
        <div class="l-title">
            <in-view :tag="'div'" v-slot="{inView}">
                <div class="m-title">
                    <div class="c-headline ">
                        <div class="c-headline__wrapper">
                            <{{ ueberschriftTyp }} class="c-headline__title" id="{{ block.titel|ascii|replace(' ', '-') }}">{{block.titel}}</{{ ueberschriftTyp }}>
                        </div>
                    </div>
                </div>
            </in-view>
        </div>
    </div>
</div>

{%- endif -%}

</section>