{% if block.text|length -%} 

<section class="section--claim" id="claim">

    <div class="container container--claim">
        <div class="claim__wrapper">
            <div class="claim__text">{{block.text}}</div>
            {% if block.buttonLink|length %}

            {% set relatedEntry = block.buttonLink.one() %}

            <div class="claim__button">
                <a class="claim__link" href="{{ relatedEntry.url }}">
                    <div class="button button--primary">{{block.buttonText}}</div>
                </a>
            </div>
            {% endif %}

        </div>
    </div>

</section>

{% endif %}