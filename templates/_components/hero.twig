<section class="hero {{ compact ?? false ? 'hero--compact' : '' }}">
    <img class="hero-art" src="{{ url('assets/template/hero-image.webp') }}" alt="" width="1672" height="941" fetchpriority="high">
    <div class="site-shell hero-inner">
        <div class="hero-copy">
            {% if breadcrumb ?? false %}<nav class="hero-breadcrumb" aria-label="Breadcrumb"><a href="{{ url('snippets') }}">Code snippets</a><span aria-hidden="true">/</span><span>{{ breadcrumb }}</span></nav>{% else %}<p class="hero-kicker">Code snippets <span>/</span> Tech notes <span>/</span> Practical solutions</p>{% endif %}
            <h1>{{ title|nl2br }}</h1>
            <p class="hero-lead">{{ description }}</p>
            {% if actions ?? false %}<div class="flex flex-wrap gap-4 hero-actions"><a class="button button--primary" href="{{ url('snippets') }}">Browse snippets {% include '_components/icon' only %}</a><a class="button" href="{{ url('topics') }}">All categories</a></div>{% endif %}
        </div>
        {% if not (compact ?? false) %}<div class="hero-index" aria-hidden="true">// snippets<br>// craft<br>// twig<br>// css<br>// laravel<br>// mac<br>// javascript</div>{% endif %}
    </div>
</section>
