{% set heroAsset = entry.hero ? entry.hero : null %}
{% set isVideo = heroAsset.one().kind == "video" ? 1 : 0 %}
{% set isBoxed = entry.heroBoxed ? 1 : 0 %}

{# TODO: can be replaced by module from tomandi (with mobile image) ? #}

{%- if isBoxed %}

    {%- set image = entry.hero.one() %}
    
    <div class="m-hero m-hero-boxed">
        <div class="m-hero-boxed__image">
            <div class="c-image c-image--center-middle" itemscope itemtype="http://schema.org/ImageObject">
                <picture class="c-image__image">
                            <source media="all and (min-width: 1200px)" data-srcset="{{ image.getUrl({ width: 1310, height:873, format: 'webp' }) }} 1x, {{ image.getUrl({ width: 1965, height:1310, format: 'webp' }) }} 1.5x" type="image/webp">
                            <source media="all and (min-width: 768px)" data-srcset="{{ image.getUrl({ width: 980, height:654, format: 'webp' }) }} 1x, {{ image.getUrl({ width: 1470, height:981, format: 'webp' }) }} 1.5x" type="image/webp">
                            <source media="all and (min-width: 320px)" data-srcset="{{ image.getUrl({ width: 480, height:480, format: 'webp' }) }} 1x, {{ image.getUrl({ width: 720, height:720, format: 'webp' }) }} 1.5x" type="image/webp">
                            <source data-srcset="{{ image.getUrl({ width: 480, height:480, format: 'webp' }) }} 1x" type="image/webp">
                            <source media="all and (min-width: 1200px)" data-srcset="{{ image.getUrl({ width: 1310, height:873, format: 'jpg' }) }} 1x, {{ image.getUrl({ width: 1965, height:1310, format: 'webp' }) }} 1.5x" type="image/jpeg">
                            <source media="all and (min-width: 768px)" data-srcset="{{ image.getUrl({ width: 980, height:654, format: 'jpg' }) }} 1x, {{ image.getUrl({ width: 1470, height:981, format: 'webp' }) }} 1.5x" type="image/jpeg">
                            <source media="all and (min-width: 320px)" data-srcset="{{ image.getUrl({ width: 480, height:480, format: 'jpg' }) }} 1x, {{ image.getUrl({ width: 720, height:720, format: 'webp' }) }} 1.5x" type="image/jpeg">
                            <source data-srcset="{{ image.getUrl({ width: 480, height:480, format: 'jpg' }) }} 1x" type="image/jpeg">
                            <img class="img lazy" loading="lazy" data-src="{{ image.getUrl({ width: 480, height:480, format: 'jpg' }) }}" title="{{image.title}}" alt="{{image.assetAltText|default(image.title)}}" itemprop="contentUrl" width="100%" height="100%"/>
                        </picture>
{#                 <div class="c-image__caption">
                    <a href="#" class="c-image__caption-link">
                         Author, Credits, Bildrechte 
                        <svg class="icon icon--poi ">
                            <use xlink:href="/themes/tonic/dist/sprites/sprite.svg#poi"></use>
                        </svg>
                    </a>
                </div> #}
            </div>
        </div>
    </div>
{%- else %}
    <header class="hero">
        <div class="hero__container">

            <div class="hero__intro-text l-container">
                
                {% if entry.heroBildUntertitel %}
                <div class="category_label">
                    <span class="category_label__word">{{ entry.heroBildUntertitel }}</span>
                </div>
                {% endif %}
                
                <h1 class="hero__heading">{{ entry.heroBildTitel|default(entry.title) }}</h1>
                

{#                 {% if entry.heroBildLink|length %}
                <a class="button hero__button" href="{{ entry.heroBildLink.getUrl() }}">{{ 'Lesen Sie mehr'|t }}</a>
                {% endif %} #}
                
            </div>

    {% if isVideo %}

        {% set videoFile = heroAsset.one() %}


            <div class="hero__video">
                <video class="hero__video--video" width="100%" autoplay loop muted playsinline importance="high" @canplay="updatePaused" @playing="updatePaused" @pause="updatePaused">
                    <source src="{{videoFile.getUrl()}}" type="video/mp4"/>
                </video>
                {% if videoFile.assetAltText|length %}
                <div class="hero__video--caption">
                    <a href="#" class="hero__video--caption-link">
                         {{videoFile.assetAltText}}
    {#                     <svg class="icon icon--poi ">
                            <use xlink:href="/themes/tonic/dist/sprites/sprite.svg#poi"></use>
                        </svg> #}
                    </a>
                </div>
                {% endif %}
            </div>

    {%- else %}
    {%- import '_macros/imageTag' as tagMacro %}

    {%- set image = entry.hero.orderBy('rand()').one() %}
    {%- set aspectRatio = image.height / image.width * 100 %}

    {%- set imageData = {
        image: image,
        widths: ['2200w', '1100w', '800w', '500w']
    } -%}


            
            <figure class="hero__image">

                <picture>
                    {%- set mobileSquare = {
                      mode: 'crop',
                      width: 500,
                      height: 500,
                      quality: 75,
                      position: 'center-center'
                      
                    } -%}
                    {%- set smallPreview = {
                        mode: 'crop',
                        width: 50,
                        height: 30,
                        quality: 70,
                        position: 'center-center'

                    } -%}
                    <source width="460" height="444" media="(max-width: 414px)" srcset="{{ image.getUrl({ width: 500, height:500, format: 'webp' }) }}" type="image/webp">
                    <source media="(min-width: 415px) and (max-width:1024px)" srcset="{{ image.url({ width: 1080, format: 'webp' }) }}" type="image/webp">
                    <source media="(min-width:1025px) and (max-width: 1280px)" srcset="{{ image.url({ width: 1600, format: 'webp' }) }}" type="image/webp">
                    <source media="(min-width:1281px)" srcset="{{ image.url({ width: 1920, format: 'webp' }) }}" type="image/webp">
                    <source width="460" height="444" media="(max-width: 414px)" srcset="{{ image.getUrl(mobileSquare) }}">
                    <source media="(min-width: 415px) and (max-width:1024px)" srcset="{{ image.url({ width: 1080 }) }}">
                    <source media="(min-width:1025px) and (max-width: 1280px)" srcset="{{ image.url({ width: 1600 }) }}">
                    <source media="(min-width:1281px)" srcset="{{ image.url({ width: 1920 }) }}">
                    <img src="{{ image.getUrl(smallPreview) }}" alt="{{ image.assetAltText|default() }}">
                </picture>
            </figure>

    {%- endif %}

{%- endif %}
    </div>
</header>


