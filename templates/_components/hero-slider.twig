{% set heroImages = entry.hero.all() %}

{# {% set imageNumber = random(0, heroImages|length) %}

{% set heroImg = heroImages[imageNumber] %}
 #}

 
    <div class="container--hero container--hero--alternative">
        <div class="hero-container">
            <div class="swiper-container hero-slider-images">
                <ul class="swiper-wrapper hero-slider-images__list">

                    {% for heroImg in heroImages %}

                        {% if heroImg.hasFocalPoint %}
                            {% set focalPoint = heroImg.getFocalPoint() %}
                            {% set position = focalPoint.x * 100 ~ '% ' ~ focalPoint.y * 100 ~ '%' %}
                        {% else %}
                            {% set position = 'center center' %}
                        {% endif %}

                        {% set image = craft.imager.transformImage(heroImg, { width: 2000, ratio: 16/9 }, {position: heroImg.getFocalPoint()} ) %}

                    <li class="swiper-slide hero-slide">
                        <figure class="hero-slide__image">
                            <img src="{{ image.url() }}" alt="{{ heroImg.title|default() }}" style="">
                        </figure>
                    </li>
                    {% endfor %}
                </ul>
                {% if heroImages|length > 1 %}
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
                {% endif %}
            </div>

            {% if craft.app.request.isLivePreview and entry.hero.width < 1600 %}
                <p>{{'Please assign an image that is at least 1600px wide.'|t}}</p>
            {% endif %}

        </div>
    </div>