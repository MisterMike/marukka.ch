                <script>
                    (function () {
                        var video = document.querySelector('#player');

                        if (Hls.isSupported()) {
                            var hls = new Hls();
                            hls.loadSource('//www.skylinewebcams.com/webcam/schweiz/graubunden/silvaplana/silvaplana.html?w=951');
                            hls.attachMedia(video);
                            hls.on(Hls.Events.MANIFEST_PARSED,function() {
