{% set hasImage = block.bild ? block.bild.one() : null %}
{% set hasCta = block.ctaLink ? block.ctaLink.one() : null %} 
{% if block.akzent == "neutral" %}
{% set hasAkzent = false %}
{% else %}
{% set hasAkzent = true %}
{% endif %}

<section class="l-section text-image akzent-{{ block.akzent|default('neutral') }}">
    <div class="l-container l-grid l-grid--singlecol background-{{block.akzent|default('neutral')}}">
        <div class="l-grid l-grid__region l-grid__region--singlecol">

            <section class="l-module l-image-text {{ block.ausrichtung == 'bildRechts' ? 'reverse' : '' }} {{hasAkzent ? 'has-akzent':''}}" id="section-{{ block.id }}">

                <in-view :tag="'div'"v-slot="{inView}">

                    <div class="m-image-text l-grid {{ hasImage ? 'has-image' : '' }}">
                        <div class="m-image-text__wrapper l-grid">
                            {% if hasImage %}
                            <div class="m-image-text__image-wrapper">
                                <div class="c-image" itemscope itemtype="http://schema.org/ImageObject">
                                    <picture class="c-image__image">
                                        <source
                                            media="all and (min-width: 320px)"
                                            data-srcset="{{ hasImage.getUrl({ width: 690, height: 460 , format: 'webp'}) }} 1x, {{ hasImage.getUrl({ width: 1035, height: 690 , format: 'webp'}) }} 1.5x" 
                                            type="image/webp">
                                        <img  
                                            src="{{ hasImage.getUrl({ width: 345, height: 230 , format: 'jpeg'}) }}" 
                                            title="{{ hasImage.title|default() }}" 
                                            alt="{{ hasImage.title|default() }}" 
                                            itemprop="contentUrl" 
                                            class="img lazy">
                                    </picture>
                                </div>
                            </div>
                            {% endif %}
                            <div class="m-image-text__text-wrapper">
                                <div class="m-image-text__title">
                                    {% include '_blocks/headline.twig' with {
                                      titel: block.titel,
                                      untertitel: block.untertitel,
                                      centered: 0,
                                      contained: 0
                                    } %}
                                </div>
                                <div class="m-image-text__text">
                                    <div class="c-text">
                                        {{ block.text }}
                                    </div>
                                </div>
                                {% if hasCta %}
                                    <div class="m-image-text__cta">
                                        <div class="c-button">
                                            <a href="{{ block.ctaLink.one().url() }}" class="button button--primary">
                                                <span class="button__label">{{ block.ctaButtonText|default('Weiterlesen')}}</span>
                                            </a>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </in-view>
            </section>

        </div>
    </div>
</section>

