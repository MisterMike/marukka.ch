<section class="section__code">
  {% if block.code|length %}

  {% do view.registerCssFile("/assets/plugins/prism/prism.min.css") %}
  {% do view.registerJsFile("/assets/plugins/prism/prism.min.js") %}
  <div class="inhalt__code">
  <pre><code class="language-{{block.codelang|default('twig')}}">
    {{ block.code|raw }}
  </code></pre>
  </div>
  {% endif %}
</section>