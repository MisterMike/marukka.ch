
{%- if block.events is defined -%}

  {%- set relatedEvents = craft.entries.section('Events').relatedTo(block) -%}

  {% if relatedEvents|length -%}

  <section class="events__wrapper">

    {%- if block.ueberschriftSubtitel|length %}<h4>{{block.ueberschriftSubtitel}}</h4>{%- endif %}
    {% if block.ueberschriftSubtitel|length %}<h2>{{block.ueberschrift}}</h2>{%- endif -%}


    {%- for event in relatedEvents.all() -%}

      {%- include "_snippets/event" with { event: event }  -%}

    {%- endfor -%}


  </section>

  {%- endif -%}

{%- endif %}