{% if block.bild|length %}
    {% set image = block.bild.one %}
{% endif %}

{% if block.internerLink|length %}

    {% set linkItem = block.internerLink.one() %}
    {% set linkHref = linkItem.url %}
    {% set linkText = linkItem.title %}

    {% set linkElement %}
        <a href="{{ linkHref }}" title="{{ image.title }}" target="_blank" class="">
    {% endset %}

{% endif %}

{% if image|length %}

    {% if image.hasFocalPoint %}
        {% set focalPoint = image.getFocalPoint() %}
        {% set position = focalPoint.x * 100 ~ '% ' ~ focalPoint.y * 100 ~ '%' %}
    {% else %}
        {% set position = 'center center' %}
    {% endif %}

    <style>

        .featured__item {
            height: 350px;
            background: url("{{ craft.picture.url(image, 'mobile') }}") no-repeat center;
            background-size: cover;
            background-position: {{ position }};
        }

        @media (min-width: 768px) {

            .featured__item {
                height: 500px;
                background: url("{{ craft.picture.url(image, 'desktop') }}") no-repeat center;
                background-size: cover;
                background-position: {{ position }};
            }

        }

    </style>

{% endif %}

<div class="featured__wrapper">
    <div class="grid__container">

        <div class="featured__item">
            <div class="featured__item--content--table">
                <div class="featured__item--content">
                    <div class="featured__item--overlay"></div>
                    {% if linkHref|length %}
                        <a href="{{ linkHref }}" title="{{ image.title }}" target="_blank" class="featured__item--link"></a>
                    {% endif %}
                    <div class="featured__item--meta">
                        <span></span>
                        <div class="featured__item--meta--category">
                            {{ linkHref|length ? linkElement : '' }}
                            {{ block.kategorie|default() }}
                            {{ linkHref|length ? '</a>' : '' }}
                        </div>

                        <h2 class="featured__item--meta--title">
                            {{ linkHref|length ? linkElement : '' }}
                            {{ block.titel }}
                            {{ linkHref|length ? '</a>' : '' }}
                        </h2>

{#                        <div class="post__meta" style="overflow: hidden;">#}
{#                            <span class="post__meta-item post__meta-date">By Emma Johnson on 19.02.2016</span>#}
{#                            <span class="post__meta-item">#}
{#                                <span data-id="1884">#}
{#                                    <a href="" title="like me" class="like_button">#}
{#                                        <i class="rt-icon icon-heart post__meta-icon"></i>#}
{#                                    </a>#}
{#                                </span>#}
{#                                <span class="votes_count_1884">4</span>#}
{#                            </span>#}
{#                        </div>#}

                        <div class="featured__item--meta--content">
                            {{ block.text | encodeEmails | replace({'<table>': '<div class="table__container table__container--inhalt"><span class="table__scroll--icon"></span><table>','</table>': '</table></div>'}) | raw }}
                        </div>

                    <br class="clear">
                </div>
            </div>
        </div>

    </div>
</div>