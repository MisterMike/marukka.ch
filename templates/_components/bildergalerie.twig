{% set bilder = block.bilder.all() %}
<div class="l-section text-image akzent-{{ block.akzent|default('neutral') }}">
    <div class="l-container l-grid l-grid--singlecol background-{{block.akzent|default('neutral')}}">
        <div class="l-grid l-grid__region l-grid__region--singlecol">
            <section id="section-{{block.id}}" class="l-module">
                
                    <div class="m-small-teaser m-small-teaser--list">

                        {% if block.titel|length %}
                            {% include '_includes/blockHeadline' with { titel: block.titel, untertitel:block.untertitel  } %}
                        {% endif %}

                        <vue-picture-swipe :items="[
                        {% for bild in bilder %}
                        {% set largeImage = bild.setTransform({ width: 1600, format: 'jpeg'}) %}
                            {src: '{{largeImage.url()}}',thumbnail: '{{ bild.getUrl({ width: 690, height: 690 , format: 'jpeg'}) }}',w: {{largeImage.width}},h: {{largeImage.height}}, title: '{{bild.title}}'},
                        {% endfor %}    
                          ]"></vue-picture-swipe>

                    </div>
                
            </section>
        </div>
    </div>
</div>