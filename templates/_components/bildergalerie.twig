<style type="text/css">



.gallery {
    
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    grid-template-rows: repeat(auto-fit, 1fr);
    grid-gap: calc(1.2em + 1.2vw);
    justify-items: auto;
}

/*.item-grid {
  display: grid;
  grid-template-columns: 1fr;
  grid-gap: calc(1.5em + 1.5vw);
  justify-items: center;
}*/

.gallery__item {
    max-height: 320px;
  }

@media screen and (min-width: 900px) {
  .gallery {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 5vw);
    grid-gap: 15px;
  }

  .gallery__item {
    max-height: 100%;
  }
}

.gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid blue;
}


.gallery__item--1 {
    grid-column: 1/3;
    grid-row: 1/5;
}

.gallery__item--2 {
    grid-column: 3/7;
    grid-row: 1/5;
}

.gallery__item--3 {
    grid-column: 7/9;
    grid-row: 1/3;
}

.gallery__item--4 {
    grid-column: 7/9;
    grid-row: 3/5;
}

.gallery__item--5 {
    grid-column: 1/3;
    grid-row: 5/7;
}

.gallery__item--6 {
    grid-column: 3/5;
    grid-row: 5/7;
}

.gallery__item--7 {
    grid-column: 5/9;
    grid-row: 5/7;
}


</style>