{% set galleryImages = block.bilder.orderBy('RAND()').all() %}

<div class="gallery">

{% for bild in galleryImages %}

    {% set bildLink = craft.picture.url(bild, 'desktop') %}

    <figure class="gallery__item gallery__item--{{ loop.index }}">
        {{ craft.picture.element(bild,'desktop',{ class: 'gallery__img', alt: bild.title, transform: { position: 'center-center', quality: 80 }}) }}
    </figure>

{% endfor %}

</div>

