{% if block.bilder|length %}

  {%- include '_includes/photoswipe' -%}
  {% do view.registerCssFile("/assets/plugins/photoswipe/photoswipe.min.css") %}
  {% do view.registerJsFile("/assets/plugins/photoswipe/photoswipe.min.js") %}
  {% do view.registerJsFile("/assets/plugins/photoswipe/photoswipe-ui-default.min.js") %}

  {% set galleryImages = block.bilder.orderBy('RAND()').all() %}

  <section id="bildergalerie__{{ block.fieldId }}" class="section__bildergalerie">
    <div class="container container--wide">
      <ul class="gallery">
        {% for bild in galleryImages %}

        {% if bild.height > bild.width %}

          {% set imageArtClass = 'hochformat' %}

        {% else %}

          {% set imageArtClass = 'breitformat' %}

        {% endif %}


          {% set bildLink = craft.picture.url(bild, 'desktop') %}
          <li>
            <figure class="gallery__item" itemprop="associatedMedia" itemscope itemtype="http://schema.org/ImageObject">
              <a href="{{ bildLink }}" itemprop="contentUrl" data-size="{{ bild.getWidth() }}x{{ bild.getHeight() }}" class="galerie__link--{{ imageArtClass }}">
                {{ craft.picture.element(bild,'desktop',{ class: 'gallery__img', alt: bild.title, transform: { position: 'center-center', quality: 80 }}) }}
              </a>
              <figcaption itemprop="{{ bild.title }}">{{ bild.title }}</figcaption>
            </figure>
          </li>
        {% endfor %}
      </ul>

  </div>

{% endif %}