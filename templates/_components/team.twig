{% set teamMembers = block.teamMitglieder.all() %}

<div class="l-section">
    <div class="l-container">
        <div class="l-grid l-grid__region l-grid__region--singlecol">
            <section class="team-members l-module">
                <in-view :tag="'div'" v-slot="{inView}">
                    <div class="m-small-teaser m-small-teaser--list">
                        {% if block.titel|length %}
                            <div class="c-headline">
                                <div class="c-headline__wrapper">
                                    <h2 class="c-headline__title thin">{{ block.titel }}</h2>
                                </div>
                            </div>
                        {% endif %}
                        <div class="m-small-teaser__wrapper l-grid">
                            {% for member in teamMembers %}

                                {% set memberPhone = member.teamTelefon|length ? member.teamTelefon ~'<br>':'' %}

                                {% set teamContent = '<p>' ~ memberPhone ~ member.teamEmail ~'</p>' %}

                                {% include '_blocks/smallTeaser' with {
                                    url: null,
                                    bild: member.teamBild.one(),
                                    bildBreite: 690,
                                    bildHoehe: 690,
                                    titel: member.teamName,
                                    topline: member.teamFunktion,
                                    content: teamContent
                                } %}
                            {% endfor %}
                        </div>
                    </div>
                </in-view>
            </section>
        </div>
    </div>
</div>