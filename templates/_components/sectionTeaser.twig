    <div class="section-teaser__element teaser__element--{{ block.sectionTeaserTitle }}">
        <div class="section-teaser__element--header" data-target="#accordeon-{{ block.id }}">
            <span class="" href="#">{{ block.sectionTeaserTitle }}</span>
            <span class="section-teaser__element--header--icon" aria-hidden="true"></span>
        </div>
        <div class="section-teaser__element--content--wrapper" id="accordeon-{{ block.id }}">
            <div class="section-teaser__element--content">
                {{ block.sectionTeaserContent }}
            </div>
        </div>
    </div>


    {%- if nextType != 'sectionTeaser' -%}
        </section>
    {%- endif -%}

