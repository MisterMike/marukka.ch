{%- if block.testimonial is defined -%}

  {%- set relatedTestimonials = craft.entries.section('Testimonials').relatedTo(block) -%}

  {% if relatedTestimonials|length -%}

    <section class="testimonial__section">
      <div class="grid__container">
        <div class="testimonial__wrapper">

          <div class="testimonial__header">
            <h2 class="testimonial__title">{{ block.testimonialTitle }}</h2>
            <h3 class="testimonial__title--byline">{{ block.testimonialSubtitle}}</h3>
          </div>

          <div class="js-Carousel testimonial__content--wrapper" id="miniCarousel">
            <ul>
              {%- for testimonial in relatedTestimonials.all() -%}

              <li class="testimonial__content">
                <div class="testimonial__text"> {{ testimonial.testimonialText}}</div>
                <div class="testimonial__author"> {{ testimonial.testimonialAuthor}}</div>
              </li>

              {%- endfor -%}
            </ul>
          </div>

        </div>
      </div>
      
    </section>

  {% endif %}

{% endif %}
