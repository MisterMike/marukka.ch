{% if block.bild|length %}

  {# Ausrichtung #}
  {% set ausrichtung = '' %}

  {% if block.ausrichtung|length %}

    {% set ausrichtung = block.ausrichtung %}

  {% endif %}

  {# Links #}
  {% set linkhref = '' %}
  {% set linkText = '' %}
  {% set linkTrue = false %}
  {% set targetblank = false %}

  {% if block.internerLink|length %}

    {% for linkItem in block.internerLink.all() %}

      {% set linkhref = linkItem.url %}
      {% set linkTrue = true %}
      {% set linkText = linkItem.title %}

    {% endfor %}

  {% elseif block.externerLink|length %}

      {% set linkhref = block.externerLink %}
      {% set targetblank = true %}
      {% set linkTrue = true %}
      {% set linkText = linkhref|replace({'http://': '', 'https://': ''}) %}

  {% elseif block.linkZuDatei|length %}

    {% for linkItem in block.linkZuDatei.all() %}

      {% set linkhref = linkItem.url %}
      {% set targetblank = true %}
      {% set linkTrue = true %}
      {% set linkText = linkItem.title %}

    {% endfor %}

  {% endif %}

  {# Bild #}
  {# check picture.php in config #}
  {% set image = block.bild.one %}

  <section class="inhalt__section">

    <div class="grid__container">

    <div class="bild__wrapper bild__wrapper--{{ ausrichtung }}">

      {{ craft.picture.element(
          image,
          'lazyLoaded',
           {
            alt: image.title,
             transform: {
               position: 'bottom-right',
               quality: 80
             }
           }
      ) }}

    </div>

    {# Inhalt #}
    {% if block.inhalt|length %}

    <div class="text__wrapper text__wrapper--{{ ausrichtung }}">

      {{ block.inhalt | encodeEmails | raw }}

      {% if linkTrue %}

        <a href="{{ linkhref }}" {% if targetblank %}target="_blank"{% endif %}>{{ linkText }}</a>

      {% endif %}

    </div>

    {% endif %}

    </div>

  </section>
  
{% endif %}