{% set image = block.bild.one() ?? null %}

{% if image %}

<section class="l-section bild akzent-{{ block.akzent|default('neutral') }}" id="section-{{block.id}}">
    <div class="l-container l-grid l-grid--singlecol">
        <div class="l-grid l-grid__region l-grid__region--singlecol">
            <div class="l-module l-image">
                <in-view :tag="'div'" v-slot="{inView}">
                    <div class="m-image l-grid">
                        <div class="m-image__media">
                            <div itemscope="itemscope" itemtype="http://schema.org/ImageObject" class="c-image">

                                <picture class="c-image__image">
                                    <source data-srcset="{{ image.getUrl({ width: 325, height: 217 , format: 'webp'}) }} 325w, {{ image.getUrl({ width: 650, height: 433 , format: 'webp'}) }} 650w, {{ image.getUrl({ width: 1300, height: 867 , format: 'webp'}) }} 1300w, {{ image.getUrl({ width: 2400, height: 1600 , format: 'webp'}) }} 2400w" type="image/webp">
                                    <source data-srcset="{{ image.getUrl({ width: 325, height: 217 }) }} 325w, {{ image.getUrl({ width: 650, height: 433 }) }} 650w, {{ image.getUrl({ width: 1300, height: 867 }) }} 1300w, {{ image.getUrl({ width: 2400, height: 1600 }) }} 2400w" type="image/jpeg">
                                    <img class="img lazy" loading="lazy" data-src="{{ image.getUrl({ width: 325, height: 217 }) }}" title="{{ image.title }}" alt="{{ image.title }}" itemprop="contentUrl" />
                                </picture>

                            </div>
                        </div>
                    </div>
                </in-view>
            </div>
        </div>
    </div>
</section>
{% endif %}