{# Params #}
{% set block = block is not defined ? false : block %}
{% set image = block ? block.bild.one() : null %}
{% set imageCaption = block.bildlegende ?? null %}

{% if block and image %}
<div class="content-padding block-bild {{ loop.last ? 'conclusion' : '' }}">
    <div class="container">
        <{{ imageCaption ? 'figure' : 'div' }} class="bild__wrapper animation-planned">
        {% if image.extension == 'svg' %}
            {{ svg(image) }}
        {% else %}

        {% include '_includes/responsiveImage' with {
            class: 'bild__bild',
            image: image,
            sizes: {
                '425px': '425px',
                '767px': '768px',
                '1023px': '1024px',
                '1439px': '1440px',
                'all': '1440px',
            },
            srcset: ['1440w', '1280w', '768w', '425w']
        } %}
        {% endif %}
        {% if imageCaption %}
            <figcaption class="bild__caption">
                {{- imageCaption -}}
            </figcaption>
        {% endif %}
        </{{ imageCaption ? 'figure' : 'div' }}>

    </div>
</div>
{% endif %}
