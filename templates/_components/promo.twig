{% if block.bild|length %}



    <section id="{{ block.id }}" class="promo  promo--wide">
        <div class="container block-link">

            <div class="promo-content">
                <div class="promo-description">
                    <h2 class="h2">{{ block.titel }}</h2>
                    <p>{{ block.inhalt }}</p>
                    <a href="{{ block.linkUrl.one().url }}" class="button ">{{ block.linkText }}</a>
                </div>
            </div>

            {% set image = block.bild.one %}
            <div class="promo-img">
                {{ craft.picture.element( image, 'promo', { alt: image.title, transform: { position: 'bottom-right', quality: 80 }} ) }}
            </div>
        </div>
    </section>

{% endif %}