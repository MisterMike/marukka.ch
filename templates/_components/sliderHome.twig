
{% if block.bild|length %}

  {%- do view.registerCssFile("/assets/plugins/owl-carousel/owl.carousel.min.css") -%}
  {%- do view.registerJsFile("/assets/plugins/owl-carousel/owl.carousel.min.js") -%}

  {%- if prevType != 'sliderHome' -%}
<div class="slider__wrapper">
  <section class="homeSlider owl-carousel" >
    {% endif %}

  {% set sliderImage = craft.picture.url(block.bild.one,'sliderHome',{transform: {position: 'center-center',quality: 90}}) %}

  {% set linkhref = '' %}
  {% set linkText = '' %}
  {% set linkTrue = false %}
  {% set targetblank = false %}

  {% if block.internerLink|length %}

    {% for linkItem in block.internerLink.all() %}

      {% set linkhref = linkItem.url %}
      {% set linkTrue = true %}
      {% set linkText = linkItem.title %}

    {% endfor %}

  {% elseif block.externerLink|length %}

    {% set linkhref = block.externerLink %}
    {% set targetblank = true %}
    {% set linkTrue = true %}
    {% set linkText = linkhref|replace({'http://': '', 'https://': ''}) %}

  {% elseif block.linkZuDatei|length %}

    {% for linkItem in block.linkZuDatei.all() %}

      {% set linkhref = linkItem.url %}
      {% set targetblank = true %}
      {% set linkTrue = true %}
      {% set linkText = linkItem.title %}

    {% endfor %}

  {% endif %}

    <div class="slider__item slider__item--initial" style="background:linear-gradient(
			  		to bottom,
			  		rgba(0,0,0,0.2) 0%,
			  		rgba(0,0,0,0.2) 100%),
			  		url({{ sliderImage }})
			  		no-repeat center center; background-size: cover;">
      <div class="slider__content-container">
        <div class="slider__content">
          
          <div class="slider__content--logo--wrapper">
            <img src="/assets/img/logo/logo-kitesailing-white.svg" alt="" class="slider__content--logo bounceInDown">
          </div>
          
          {% if block.ueberschrift|length %}
            <h2 class="slider__title title-big">{{ block.ueberschrift }}</h2>
          {% endif %}
          {% if block.inhalt|length > 0 %}
            {{ block.inhalt }}
          {% endif %}
          {% if linkTrue %}
            <a href="{{ linkhref }}" class="button_calltoAction" {% if targetblank %}target="_blank"{% endif %}>Mehr erfahren</a>
          {% endif %}
        </div>
      </div>
    </div>

  {% if nextType != 'sliderHome' %}
    </section></div>
      {% js %}
        document.addEventListener("DOMContentLoaded",function(){
          $(".owl-carousel").owlCarousel({
            items: 1,
            dots: !0,
            nav: !0,
            loop: !0,
            autoplay: !0,
            smartSpeed: 1e3,
            autoplayHoverPause: !0,
            autoplayTimeout: 1e4,
            loadingClass: "owl-loading",
            navText: ['<svg class=\'owl-nav__icon\' xmlns="http://www.w3.org/2000/svg" viewBox="0 0 13.1 23"><path class="st0" d="M0 11.5c3.8 3.8 7.6 7.6 11.5 11.5l1.4-1.4 -10-10L13.1 1.4c-0.5-0.5-0.9-0.9-1.4-1.4C7.8 3.8 3.9 7.7 0 11.5z"/></svg>\n', '<svg class=\'owl-nav__icon\' xmlns="http://www.w3.org/2000/svg" viewBox="0 0 13.1 23"><path class="st0" d="M13.1 11.5C9.3 7.7 5.5 3.9 1.6 0L0.2 1.4l10 10L0 21.6c0.5 0.5 0.9 0.9 1.4 1.4C5.3 19.2 9.2 15.3 13.1 11.5z"/></svg>']
          });
        });
      {% endjs %}
  {%  endif %}

{% endif %}