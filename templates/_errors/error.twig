{% set selectedEntry = craft.entries.id(26).one() %}
{% set selectedPath = selectedEntry.getUrl()%}
{% set linkActiveBreadcrumbPath = true %}

{% set seitenBild = standardBilder.seitenbild.one() %}


{% extends '_layouts/base' %}

{% block content %}

    <main>
        <div class="grid__container">
            <div class="content__1-1">
                <br >
                <h4 class="content__heading--sectionname">Fehler</h4>
                <h1 class="content__heading--pagetitle">Allgemeiner Fehler</h1>
            </div>
        </div>

        <div class="grid__container">
            <div class="content__3-4">



            </div>

            <aside class="content__1-4">

                {% if entry.globaleSeitenleisteVerwenden == '1' or not entry.sidebarMatrix|length %}

                    {% set sidebarBlocks =  seitenleisteGlobal.globaleSeitenleiste.all() %}

                {%- else -%}

                    {% set sidebarBlocks =  entry.sidebarMatrix.all() %}

                {% endif %}

                {% if sidebarBlocks|length %}

                    {% include "_routers/snippet" with { blocks: sidebarBlocks }  %}

                {% endif %}

            </aside>
        </div>

        {%  set seitenAbschluss = entry.inhaltMatrix.type('seitenAbschluss').all() %}
        {% if seitenAbschluss|length %}
            {%- include "_routers/component" with { blocks: seitenAbschluss }  -%}
        {% endif %}

    </main>

    <small style="font-size:0.7rem;">{{ devMode ? 'tpl: '~_self : '' }}</small>

{% endblock %}
