{% extends "_layouts/base" %}

{% block content %}

<main role="main">

    {#  Generate the fullscreen homescreen with slider and sectionTeaser  #}
    {% if entry.sliderMatrix|length %}
        <section class="homepage__slider">

            {%- include "_routers/component" with { blocks: entry.sliderMatrix.all() } only -%}

            {%- set teaserMatrix = entry.inhaltMatrix.type('sectionTeaser') -%}
            {% if teaserMatrix|length %}
                {%- include "_routers/component" with { blocks: teaserMatrix }  -%}
            {% endif %}
        </section>
    {% endif %}

        <section class="homepage__content">

            {#  Get the rest of the blocks except sectionTeaser  #}
            {%- include "_routers/component" with { blocks: entry.inhaltMatrix.type('not sectionTeaser') }  -%}
            {%- include "_routers/component" with { blocks: entry.adminInhaltMatrix.all() } -%}

        </section>

</main>

{% endblock %}
