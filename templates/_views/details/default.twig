{% set linkActiveBreadcrumbPath = false %}

{% set seitenBild = entry.seitenbild.one()|default(standardSeitenbild.seitenbild.one()) %}

{% extends "_layouts/base" %}

{% block content %}

  {% if seitenBild is defined and seitenBild is not empty %}
    {%- include "_includes/headerbild" with { image: seitenBild } -%}
  {% endif %}


<main role="main" class="main__content">
  <div class="section__outer">

    {%- include "_includes/breadcrumb" -%}

    <article class="content__wrapper">

      <div class="container">
        <h1>{{ entry.seitenUeberschrift|length ? entry.seitenUeberschrift : entry.title }}</h1>
      </div>

      {% if entry.inhaltMatrix|length %}
        {% set inhaltsBlocks = entry.inhaltMatrix.all() %}
        {%- include "_routers/component" with { blocks: inhaltsBlocks } -%}
      {% endif %}

    </article>

  </div>
</main>

{% endblock %}