{% if article is defined %}
  <article class="news__article" data-aos='fade' data-aos-easing="ease-in-out">
    <section class="news__article--section">
      <h2 class="article__header"><span class="article__header--id">#{{article.id}}</span> {{article.title}}</h2>
      <p>{{article.teaserText}}</p>
    </section>
  </article>
{% endif %}