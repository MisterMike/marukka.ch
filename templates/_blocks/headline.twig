    <div class="c-headline c-headline--inline {{ centered ? 'c-headline--centered':'' }}">
        <div class="c-headline__wrapper">
            <h2 class="c-headline__title">{{ titel }}</h2>
            {% if untertitel|length %}
                <p class="c-headline__topline h3 thin">{{ untertitel}}</p>
            {% endif %}
        </div>
    </div>

    {%- endset -%}

    {% if contained is defined and contained == 0 %}
        {{headlineContent}}
    {% else %}
        <div class="l-container l-grid">{{headlineContent}}</div>
    {% endif %}

{%- endif %}

