{% set domainUrl = "http://www.tab-aesch.ch/" %}
{% set craftLocale = craft.locale | replace("_","-") %}
{% set unsubscribeUrl = "http://tab-aesch.us14.list-manage1.com/unsubscribe?u=3e5b89469dee87cc487973c2f&id=43b8e7db80" %}

{% set email.fromName = 'Tennis an der Birs' %}
{% set email.fromEmail = 'info@tab-aesch.ch' %}
{% set email.replyTo = 'info@tab-aesch.ch' %}

{# CSS - the craft way #}
{% set CSS__tag__p = "color: #333333; font-size: 16px; line-height: 24px; margin: 0;" %}
{% set CSS__tag__p_g = "color: #6e6e6e; font-size: 16px; line-height: 24px; margin: 0;" %}
{% set CSS__tag__p_g_big = "color: #6e6e6e; font-size: 20px; line-height: 24px; margin: 0;" %}
{% set CSS__tag__h2 = "font-size: 34px; color: #113f93; margin: 0;font-weight:100;" %}
{% set CSS__tag__h2_small   = "font-size: 28px; color: #ffffff;margin: 0; margin-bottom: 5px;font-weight:700;" %}
{% set CSS__tag__hr         = "border: 0;height: 1px;background: #113f93;margin-bottom:20px;" %}
{% set CSS__tag__hr_g       = "border: 0;height: 1px;background: #6e6e6e;margin-bottom:20px;" %}
<!doctype html>
<html lang="{{craftLocale}}">
    <head>
    <title>{{ email.subjectLine }} - {{ siteName }}</title>
<meta charset="UTF-8">
<style type="text/css">
/* CLIENT-SPECIFIC STYLES */
body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
img { -ms-interpolation-mode: bicubic; }
p { color: #333333; font-size: 16px; line-height: 24px; margin: 0; }
/* RESET STYLES */
img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
table { border-collapse: collapse !important; }
body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; }

/* iOS BLUE LINKS */
a[x-apple-data-detectors] {
    color: inherit !important;
    text-decoration: none !important;
    font-size: inherit !important;
    font-family: inherit !important;
    font-weight: inherit !important;
    line-height: inherit !important;
}

/* MOBILE STYLES */
@media screen and (max-width: 600px) {
  .img-max {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
  }

  .max-width {
    max-width: 100% !important;
  }

  .mobile-wrapper {
    width: 85% !important;
    max-width: 85% !important;
  }

  .mobile-padding {
    padding-left: 5% !important;
    padding-right: 5% !important;
  }
}

/* ANDROID CENTER FIX */
div[style*="margin: 16px 0;"] { margin: 0 !important; }
</style>
<link rel="stylesheet" type="text/css" href="/tpl/css/print-newsletter.css">
</head>
<body style="margin: 0 !important; padding: 0; !important background-color: #ffffff;" bgcolor="#ffffff">



<table border="0" cellpadding="0" cellspacing="0" width="100%">

    <tr>
        <td align="center" valign="top" width="100%" background="images/bg.jpg" bgcolor="#ffffff" style="background: #ffffff; background-size: cover; padding: 12px 15px;" class="mobile-padding">
            <!--[if (gte mso 9)|(IE)]>
            <table align="center" border="0" cellspacing="0" cellpadding="0" width="600">
            <tr>
            <td align="center" valign="top" width="600">
            <![endif]-->
            <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;">
                <tr>
                    <td align="left" valign="top" style="padding: 0; font-family: Open Sans, Helvetica, Arial, sans-serif;width:50%;">
                        <p style="color: #ffffff; font-size: 20px; line-height: 28px; margin: 0;">
                            <a style="font-size:16px;color:#767474;text-decoration:none;text-transform: uppercase;" href="tel:0041617515151">T +41 61 751 51 51</a>
                        </p>
                    </td>
                    <td align="right" valign="top" style="padding: 0; font-family: Open Sans, Helvetica, Arial, sans-serif;width:50%;">
                        <p style="color: #ffffff; font-size: 20px; line-height: 28px; margin: 0;">
                            <a style="font-size:16px;color:#767474;text-decoration:none;text-transform: uppercase;" href="mailto:info@tab-aesch.ch">info@tab-aesch.ch</a>
                        </p>
                    </td>
                </tr>
            </table>
            <!--[if (gte mso 9)|(IE)]>
            </td>
            </tr>
            </table>
            <![endif]-->
        </td>
    </tr>
       
    <tr>
        <td align="center" valign="top" width="100%" bgcolor="#f6f6f6" style="background: #f6f6f6; background-size: cover; padding: 0 15px;" class="mobile-padding">
            <!--[if (gte mso 9)|(IE)]>
            <table align="center" border="0" cellspacing="0" cellpadding="0" width="600">
            <tr>
            <td align="center" valign="top" width="600">
            <![endif]-->
            <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;">
                <tr>
                    <td align="center" valign="top" style="padding: 0 0 20px 0;">
                        <img src="{{domainUrl}}tpl/img/Newsletter_Logo.png" width="135" height="" border="0" style="display: block;">
                    </td>
                </tr>
            </table>
            <!--[if (gte mso 9)|(IE)]>
            </td>
            </tr>
            </table>
            <![endif]-->
        </td>
    </tr>

    <tr>
        <td align="center" height="100%" valign="top" width="100%" bgcolor="#f6f6f6" style="padding: 50px 15px;" class="mobile-padding">
            <!--[if (gte mso 9)|(IE)]>
            <table align="center" border="0" cellspacing="0" cellpadding="0" width="600">
            <tr>
            <td align="center" valign="top" width="600">
            <![endif]-->
            <table bgcolor="#ffffff" align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;">
                <tr>
                    <td align="center" valign="top" bgcolor="#ffffff" style="padding: 0 0 25px 0; font-family: Open Sans, Helvetica, Arial, sans-serif;background:#ffffff;">
                        <table cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                                <td align="center" bgcolor="#ffffff" style="border-radius: 0 0 3px 3px; padding: 25px;">
                                    <table cellspacing="0" cellpadding="0" border="0" width="100%">
                                        <tr>
                                            <td align="left" style="font-family: Open Sans, Helvetica, Arial, sans-serif;">
                                                <h2 style="{{CSS__tag__h2}}">{{ email.subjectLine }}</h2>
                                                <br>
                                                <p style="{{CSS__tag__p_g_big}}">{{ email.newsletterEinleitung|nl2br }}</p>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                      </table>
                    </td>
                </tr>

{% set prevType = null %}
{% set nextType = null %}

{% for block in email.newslettermatrix %}

{% set type = (nextType ?: block.type.handle) %}

{% set type = block.type.handle %}
{% set nextType = (not loop.last ? block.next().type.handle : "last") %}
{% switch type %}

    {% case 'box' %}     
       
                <tr class="nl-pb-before">
                    <td align="center" valign="top" style="padding: 0 0 0 0; font-family: Open Sans, Helvetica, Arial, sans-serif; border-top: 1px solid #ffffff;">
                        <table cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                                <td align="center" bgcolor="#ffffff" style="border-radius: 0 0 3px 3px; padding:0;padding-right: 25px;padding-left: 25px;">
                                    <table cellspacing="0" cellpadding="0" border="0" width="100%">
                                        <tr>
                                            <td align="left" style="font-family: Open Sans, Helvetica, Arial, sans-serif;">
                                                <hr style="{{CSS__tag__hr}}">
                                                <table cellspacing="0" cellpadding="0" border="0" width="100%">
                                                    <tr>
                                                        <td width="60" valign="top" align="left" style="width: 60px;font-family: Open Sans, Helvetica, Arial, sans-serif;">
                                                            {% if block.picto | length %}
                                                                {% for category in block.picto %}
                                                                    <img src="{{domainUrl}}tpl/img/icons/Picto_{{ category.title }}.png" width="45" height="45" border="0" style="display: block;">
                                                                {% endfor %}
                                                            {% endif %}
                                                            <br>
                                                            <br>
                                                        </td>
                                                        <td>
                                                            {% if block.titel | length %}
                                                                <h2 style="{{CSS__tag__h2}}">{{ block.titel | upper }}</h2>
                                                            {% endif %}
                                                            <br>
                                                            <br>
                                                        </td>
                                                    </tr>
                                                </table>
            
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>      

                            {% set image = block.bild.first %}
                            {% if image | length %}
                            

                            <tr>
                                <td align="center" bgcolor="#ffffff" style="border-radius: 0 0 3px 3px; padding:0;padding-bottom: 25px;padding-right: 25px;padding-left: 25px;">
                                    <table cellspacing="0" cellpadding="0" border="0" width="100%">                                                                           
                                        <tr>
                                            <td align="left" style="font-family: Open Sans, Helvetica, Arial, sans-serif;">
                                                                                                
                                                        <img src="{{domainUrl}}{{image.getURL('newsletter')}}" width="550" height="" alt="{{image.title}}" style="display: block; border-radius: 2px; font-family: sans-serif; font-size: 16px; color: #6e6e6e;" class="img-max"/>

    
                                            </td>
                                        </tr>
                                        
                                    </table>
                                </td>
                            </tr>
                            
                                                        
                                     
                            {% endif %}                                               
                                                                                                                
                                                                                                                                                                        
                            
                            

                            <tr>
                                <td align="center" bgcolor="#ffffff" style="border-radius: 0 0 3px 3px; padding: 25px; padding-top:0;">
                                    <table cellspacing="0" cellpadding="0" border="0" width="100%">                                                                           
                                        <tr>
                                            <td align="left" style="font-family: Open Sans, Helvetica, Arial, sans-serif;">
                                                                                                
                                            {% if block.inhalt | length %}
                                                {{ block.inhalt }}
                                            {% endif %}
    
                                            </td>
                                        </tr>
                                        
                                        
                                        {% set linkUrl = '' %}
                                        {% if block.internerLink.first() | length %}
                                            {% set linkUrl = block.internerLink.first().getUrl() %}
                                            {% set linkText = block.linktext %}
                                            {% if linkText == "" %}
                                                {% set linkText = block.internerLink.first().getTitle() %}
                                            {% endif %}
                                        {% elseif block.externerLink | length %}
                                            {% set linkUrl = block.externerLink %}
                                            {% set linkText = block.linktext %}
                                            {% if linkText == "" %}
                                                {% set linkText = linkUrl %}
                                            {% endif %}
                                        {% elseif block.dateilink.first() | length %}
                                            {% set linkUrl = block.dateilink.first().getUrl() %}
                                            {% set linkText = block.linktext %}
                                            {% if linkText == "" %}
                                                {% set linkText = block.internerLink.first().getTitle() %}
                                            {% endif %}
                                            
                                            {% if 'http' in linkUrl %}
                                            {% else %}
                                                {% set linkUrl = "http://www.tab-aesch.ch" ~ linkUrl %}
                                            {% endif %}
                                            
                                        {% endif %}

                                        {% if linkUrl | length %}
                                            
                                            
                                            
                                        <tr>
                                            <td align="left" style="padding: 0px 0 0 0;">
                                               <p>
                                                   <a style="text-transform: uppercase;color: #113f93;text-decoration: none;font-size: 20px;" href="{{linkUrl}}">></a> 
                                                   <a style="text-transform: uppercase;color: #113f93;text-decoration: none;font-size: 16px;" href="{{linkUrl}}">{{linkText}}</a></p>
                                            </td>
                                        </tr>
                                            
                                        {% endif %}

                                    </table>
                                </td>
                            </tr>
                            
                            
                           
                                                                                   
                            
                      </table>
                    </td>
                </tr>

    {% endswitch %}

{% set prevType = block.type.handle %}

{% endfor %}

           
           
                <tr>
                    <td align="center" valign="top" style="padding: 0 0 0 0; font-family: Open Sans, Helvetica, Arial, sans-serif; border-top: 1px solid #ffffff;">
                        <table cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                                <td align="center" bgcolor="#113f93" style="border-radius: 0 0 3px 3px; padding: 25px;">
                                    <table cellspacing="0" cellpadding="0" border="0" width="100%">
                                        <tr>
                                            <td align="center" style="font-family: Open Sans, Helvetica, Arial, sans-serif;">
                                                <table cellspacing="0" cellpadding="0" border="0" width="100%">
                                                    <tr>
                                                        <td align="center" >
                                                            <h2 style="{{CSS__tag__h2_small}}">Dein Sport. Dein Erlebnis. Dein Center.</h2>
                                                            <img src="{{domainUrl}}tpl/img/Newsletter_Iconleiste.png" width="305" height="45" alt="Iconleiste" style="display: block; border-radius: 2px; font-family: sans-serif; font-size: 16px; color: #6e6e6e;padding-bottom:15px;padding-top:20px;" class="img-max"/>            
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>      
                        </table>
                    </td>
                </tr>

          

                <tr>
                    <td align="center" valign="top" style="padding: 0 0 0 0; font-family: Open Sans, Helvetica, Arial, sans-serif; border-top: 1px solid #ffffff;">
                        <table cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                                <td align="center" bgcolor="#ffffff" style="border-radius: 0 0 3px 3px; padding: 25px;padding-top: 0;">
                                    <table cellspacing="0" cellpadding="0" border="0" width="100%">
                                        <tr>
                                            <td align="left" style="font-family: Open Sans, Helvetica, Arial, sans-serif;">
                                                <br>
                                                <hr style="{{CSS__tag__hr}}">
                                                <table cellspacing="0" cellpadding="0" border="0" width="100%">
                                                    <tr>
                                                        <td>
                                                            <center><p style="{{CSS__tag__p_g}}">TAB | Industriestrasse 151 | CH-4147 Aesch | T +41 61 751 51 51<br>info@tab-aesch.ch</p></center>
                                                            <br>
                                                        </td>
                                                    </tr>
                                                </table>
                                                <hr style="{{CSS__tag__hr_g}}">
                                                <p style="{{CSS__tag__p_g}}"> &copy; TAB {{ now.year }} </p>

                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>      
                        </table>
                    </td>
                </tr>

          
                    
                                        
           
            </table>
            <!--[if (gte mso 9)|(IE)]>
            </td>
            </tr>
            </table>
            <![endif]-->
        </td>
    </tr>
    <tr class="nl-hide">
        <td align="center" height="100%" valign="top" width="100%" bgcolor="#f6f6f6" style="padding: 0 15px 40px 15px;">
            <!--[if (gte mso 9)|(IE)]>
            <table align="center" border="0" cellspacing="0" cellpadding="0" width="600">
            <tr>
            <td align="center" valign="top" width="600">
            <![endif]-->
            <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;">
                <tr>
                    <td align="center" valign="top" style="padding: 0; font-family: Open Sans, Helvetica, Arial, sans-serif; color: #6e6e6e;">
                        <a href="{{email.url}}" style="color: #6e6e6e;" target="_blank">Newsletter im Browser anzeigen </a>
                        &nbsp; &bull; &nbsp;
                        <a href="{{unsubscribeUrl}}" style="color: #6e6e6e;" target="_blank">Abmelden</a>
                        </p>
                    </td>
                </tr>
            </table>
            <!--[if (gte mso 9)|(IE)]>
            </td>
            </tr>
            </table>
            <![endif]-->
        </td>
    </tr>
</table>

</body>
</html>
