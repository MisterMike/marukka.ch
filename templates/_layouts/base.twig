{% set categories = categories ?? craft.entries.section('categories').with(['categoryImage']).orderBy('title asc').all() %}
{% set pageTitle = pageTitle ?? (entry is defined and entry.section.handle != 'home' ? entry.title ~ ' — Marukka' : 'Marukka — Code snippets & practical solutions') %}
{% set pageDescription = pageDescription ?? (entry.lead ?? 'Useful code snippets, practical solutions and technical notes for Craft CMS, Twig, CSS, Laravel, Mac and JavaScript.') %}
<!DOCTYPE html>
<html lang="{{ craft.app.language|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#071e2b">
    <title>{{ pageTitle }}</title>
    {% set seomate = {canonicalUrl: canonicalUrl ?? craft.app.request.absoluteUrl, meta: {title: pageTitle, description: pageDescription, 'og:title': pageTitle, 'twitter:title': pageTitle, 'og:description': pageDescription, 'twitter:description': pageDescription}} %}
    {% hook 'seomateMeta' %}
    {% if craft.app.config.general.disallowRobots %}<meta name="robots" content="noindex, nofollow">{% elseif noindex ?? false %}<meta name="robots" content="noindex, follow">{% endif %}
    <link rel="icon" href="{{ url('assets/brand-mark.svg') }}" type="image/svg+xml">
    {{ craft.vite.script('src/js/app.js', false) }}
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {% include '_includes/header' with {categories: categories} only %}
    <main id="main-content" tabindex="-1">{% block content %}{% endblock %}</main>
    {% include '_includes/footer' %}
</body>
</html>
