{% set devMode = craft.app.config.general.devMode %}
{% set frontendDebug = craft.app.config.custom.debugFrontend %}
{% set cacheTag = craft.app.config.custom.litespeedCacheTag %}
{% set staticAssetsVersion = craft.app.config.custom.staticAssetsVersion %}

{% if entry is not defined %}
  {% set entry = craft.entries({
    "uri": "__home__",
  }).one() %}
{% endif %}

{% if entry.hero is defined and entry.hero|length > 0 %}
  {% set hasHero = 1 %}
{% else %}
  {% set hasHero = 0 %}
{% endif %}

 {% block cacheHeader %}
   {% if not entry.nichtCachen|default(false) and not devMode and craft.app.request.getQueryParam("x-craft-live-preview")|length == 0 %}
     {% header "X-LiteSpeed-Cache-Control:public,max-age=604800" %}
     {% header "X-LiteSpeed-Tag: #{cacheTag}" %}
   {% else %}
     {% header "X-LiteSpeed-Cache-Control:no-cache" %}
   {% endif %}
 {% endblock %}

{% set flashNotice = craft.app.session.getFlash('notice') %}
{% set flashError = craft.app.session.getFlash('error') %}

{# spaceless#}

{% if not selectedPath is defined %}
  {% set selectedPath = craft.app.request.absoluteUrl %}
{% endif %}

{# Dieser Parameter ist beispielsweise für Team Sektion gedacht, einfach true setzen #}
{% if not linkActiveBreadcrumbPath is defined %}
  {% set linkActiveBreadcrumbPath = false %}
{% endif %}

{% set mainNavigation %}
  {# Output Main-Navigation #}
  {%- include "_macros/main-navigation" with { sectionName: 'website', cssClass: "main-menu__list" } -%}
{% endset %} 

{% set mainNavigation = mainNavigation | k4NavigationGetActivePath(selectedPath) %}

