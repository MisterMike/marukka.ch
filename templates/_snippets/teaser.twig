{% set teaserImage = teaserBlock.seitenbild.one() %}
{% set teaserURL = teaserBlock.getURL() %}

<li>
	<div class="item-content">
		<a href="{{ teaserURL }}">
			<div class="item-img ">
				{% if teaserImage is defined and teaserImage is not empty %}
					{{ craft.picture.element( teaserImage, 'teaser', { alt: teaserImage.title, transform: { position: 'bottom-right', quality: 80 } } ) }}
				{% endif %}
			</div>
		</a>
		<div class="item-description">
			<h5 class="h5">{{ teaserBlock.seitenUeberschrift|length ? teaserBlock.seitenUeberschrift : teaserBlock.title }}</h5>
			<p>{{ teaserBlock.teaserText }}</p>
			<a href="{{ teaserURL }}" class="button">{{ 'Weiterlesen' | t }}</a>
		</div>
	</div>
</li>

