<div class="services__widget col-{{ columnWidth }} "
	 data-sal="fade"
	 data-sal-delay="500"
	 data-sal-duration="500"
	 data-sal-easing="ease-in-out"
>
	{% set serviceImage = kiteService.seitenbild.one() %}
	
	<div class="services__widget--image" >
		<div class="services__widget--image-link">
			{% if serviceImage is defined and serviceImage is not empty %}
                {{ craft.picture.element( serviceImage, 'teaser', { alt: serviceImage.title, transform: { position: 'bottom-right', quality: 80 } } ) }}
            {% endif %}
		</div>
	</div>

	<div class="services__widget--content">
		<div class="services__widget--content-2">
			<h4 class="services__widget--header">
				<a class="services__widget--link" href="{{kiteService.getURL()}}">
					{{ kiteService.seitenUeberschrift|length ? kiteService.seitenUeberschrift : kiteService.title }}
				</a>
			</h4>
			<p class="services__widget--text">{{ kiteService.teaserText }}</p>
		</div>
		<div class="services__widget--readmore" >
			<a href="{{kiteService.getURL()}}" class="services__widget--morelink">
				<span class="icon-right-open"></span>
				<span class="services__widget--morelink--text">{{ 'Mehr lesen' | t }}</span>
			</a>
		</div>
	</div>


</div>