<form method="get">
  <input type="text" name="q" value="{{ craft.app.request.getParam('q') }}">
  <input type="submit" name="submitSearch" value="Suche">    
</form> 

{% set searchQuery = craft.app.request.getParam('q') %}

{# Fetch entries that match the search query #}
{% if searchQuery == "" %}
Bitte geben Sie einen Suchbegriff an.

{% else %}

  {% set results = craft.entries()
    .search(searchQuery)
    .all() %}

    {% if results | length %}

    <p>Ihre Suche nach "{{ craft.app.request.getParam('q') }}" hat {{ results|length }} Resultat{% if results|length > 1%}e{% endif %} ergeben.</p>

      <ul>
        
      {% for entry in results %}
        
        <li>
          <a href="{{ entry.getUrl() }}">
            <b>{{ entry.title }}</b>
          </a>
          <small> ({{ entry.dateUpdated |date('M j, Y')}})</small><br>
          <small>{{ entry.getUrl() }}</small><br>
          <p>{{ entry.suchtext }}</p>
  
        {% endfor %}
          
        {% else %}
          <p>Sorry, Ihre Suche hat keine Resultate ergeben.</p>
        {% endif %}
          
      </ul>
    
{% endif %}

