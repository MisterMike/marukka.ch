{% macro errorList(errors) %}
  {% if errors %}

    <ul class="kontakt-errors__items">
      {% for error in errors %}
        <li class="kontakt-errors__item">{{ error }}</li>
      {% endfor %}
    </ul>

  {% endif %}
{% endmacro %}

<section class="kontakt__section">

{% if craft.app.session.hasFlash('error') %}

  <div class="grid__container">
    <p class="message error">{{ craft.app.session.getFlash('error') }}</p>
  </div>

  {% js %}

    const element = document.querySelector('.kontaktform');
    const offset = 300;
    const bodyRect = document.body.getBoundingClientRect().top;
    const elementRect = element.getBoundingClientRect().top;
    const elementPosition = elementRect - bodyRect;
    const offsetPosition = elementPosition - offset;

    window.scrollTo({
      top: offsetPosition,
      behavior: 'smooth'
    });

  {% endjs %}

{% endif %}

{% from _self import errorList %}

{% set danke = craft.app.request.getParam('q') %}

{% if danke == "danke" %}

<div class="kontakt__danke--wrapper">

  <h2 class="heading__big">Schön, von Ihnen zu hören.</h2>

  <p>Wir melden uns bald bei Ihnen.</p>

</div>

{% else %}

  <div class="grid__container">

    <div class="kontaktform__wrapper">

    <form class="kontaktform" method="post" action="" accept-charset="UTF-8">
      {{ csrfInput() }}
      <input type="hidden" name="action" value="contact-form/send">
      {{ redirectInput('kontakt?q=danke#kontakt') }}

      <h3 class="kontatkform__heading"><label for="from-name">Ihr Name</label></h3>
      <input id="from-name" type="text" name="fromName" value="{{ message.fromName ?? '' }}">
      {{ message is defined and message ? errorList(message.getErrors('fromName')) }}

      <h3 class="kontatkform__heading"><label for="from-email">Ihre E-Mail</label></h3>
      <input id="from-email" type="email" name="fromEmail" value="{{ message.fromEmail ?? '' }}"
        {% if message is defined and message %} 
           {% if message.getErrors('fromEmail') %}
            class="input__error"
           {% endif %}
        {% endif %}
      >
      
      {{ message is defined and message ? errorList(message.getErrors('fromEmail')) }}

      <h3 class="kontatkform__heading"><label for="message">Mitteilung</label></h3>
      <textarea rows="10" cols="40" id="message" name="message"         
        {% if message is defined and message %} 
          {% if message.getErrors('message') %}
            class="input__error"
          {% endif %}
        {% endif %}
      >
        
      {{ message.message ?? '' }}</textarea>
      {{ message is defined and message ? errorList(message.getErrors('message')) }}

      <input id="secretHoneypotK4" name="secretHoneypotK4" type="text">

      <input class="submit" type="submit" value="Senden">

    </form>
    </div>
  </div>

{% endif %}
</section>