{#
 # Snippet Router Template
 # ----------------------
 #
 # This template gets loaded whenever a Snippet View is requested in a parent view.
 #
 # An `entry` variable is expected in this template.
-#}

{% set prevType = null %}
{% set nextType = null %}

{% for i, block in blocks %}

  {% set type = (nextType ?: block.type.handle) %}
  {% set nextType = (not loop.last ? blocks[i+1].type.handle) %}

  {%- include [
    '_views/snippets/' ~ block.type.handle,
    '_views/snippets/default',
  ] -%}

  {% set prevType = type %}

{% endfor %}
