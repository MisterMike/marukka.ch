{%- macro recursive_nav(entries, cssClass, depth, wrapUl) -%}

  {% set nichtAnzeigen = false %}

  {%- import _self as self -%}

  {%- if wrapUl %}
    <ul class="sub-menu {{ cssClass }}__nav--items--level{{ depth }}">
  {% endif -%}

  {%- for entry in entries.all() -%}

    {%- if entry.nichtInNavigationAnzeigen == false -%}

        <li class="menu-item {{ cssClass }}__nav--item--level{{ depth }} {% if entry.hasDescendants %}has--children{% endif %} {{entry.callToActionButton ? 'ctaButton' : ''}}">
          {%- set itemLink = entry.url -%}

          {%- if entry.hasDescendants -%}

            {% set children = entry.getChildren().all() %}

            {% for children in children if children.nichtInNavigationAnzeigen == true %}

              {% set nichtAnzeigen = true %}

            {% endfor %}

            {%- if (depth != '3') and (nichtAnzeigen != true) -%}
              <span class="button__open--level button__open--level{% if depth == '1' %}-2{% else %}-3{% endif %} {% if craft.app.request.segments|first == entry.slug %}active{% endif %}"></span>
            {% endif -%}

          {%- endif -%}
          <a href="{{ itemLink }}" class="{{ cssClass }}__nav--link--level{{ depth }}">{{ entry.title }}</a>
          {%- if entry.hasDescendants -%}
            {{ self.recursive_nav(entry.children, cssClass, depth+1, true) }}
          {%- endif -%}
        </li>

    {%- endif -%}

  {%- endfor -%}

  {%- if wrapUl %}
    </ul>
  {% endif -%}

{%- endmacro -%}

{%- import _self as self -%}

<ul class="{{ cssClass }}__nav--items--level1">

  {% set navEntries = craft.entries.section(sectionName ?? entry.section).level(1) %}
  {{ self.recursive_nav(navEntries,(cssClass == "" ? entry.section : cssClass ), 1, false)  }}

</ul>