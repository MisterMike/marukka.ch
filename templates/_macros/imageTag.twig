{% macro imageTag(imageData) %}
    {% set image = imageData.image %}
    {% set widths = imageData.widths %}
    {% set transform = imageData.transform ?? {} %}
    {% set preloadImage = imageData.preloadImage ?? '/assets/img/preloader.svg' %}
    {% set class = imageData.class ?? 'lazyload img-fluid' %}
    {% set tag = imageData.tag ?? 'img' %}
    {% set media = imageData.media ?? '' %}

    {% do image.setTransform(transform) %}
    {% if tag == 'img' %}
        {{
        tag(
            'img',
            {
                src: preloadImage,
                'data-sizes': 'auto',
                'data-srcset': image.getSrcset(widths),
                alt: image.assetAltText|default(image.title),
                class: class
            }
        )
        }}
    {% else %}
        {{
        tag(
            'source',
            {
                'data-sizes': 'auto',
                'data-srcset': image.getSrcset(widths),
                media: media
            }
        )
        }}
    {% endif %}
{% endmacro %}
