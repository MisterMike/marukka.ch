{% if image|length %}

    {% set transformedImages = craft.imager.transformImage(image,
        [
            { width: 1200, ratio: 16/6 },
            { width: 1024, ratio: 16/6 },
            { width: 400, ratio: 5/7, jpegQuality: 75 },
        ],
        {
            format: 'jpg',
            allowUpscale: false,
            mode: 'crop',
            jpegQuality: 80,
            position: image.getFocalPoint(),
            interlace: true
        }
    ) %}
  <div class="seitenbild">
      <div class="media ">
          <div class="field">
{#              <img class="img lazyload"#}
{#                   src="{{ craft.imager.base64Pixel(2,1) }}"#}
{#                   data-sizes="100vw"#}
{#                   data-srcset="{{ craft.imager.srcset(transformedImages) }}"#}
{#                   alt="{{ image.title }}"#}
{#              />#}

              {% set transformedImages = craft.imager.transformImage(image, [{ width: 400 },{ width: 1200 },{ width: 1900 }], { ratio: 16/9 }, { fillTransforms: true }) %}

              <img class="img lazyload"
                   src="{{ craft.imager.placeholder({ width: 16, height: 9 }) }}"
                   data-sizes="100vw"
                   data-srcset="{{ transformedImages | srcset }}">

          </div>
      </div>
  </div>


{% endif %}