<header class="site-header" x-data="navigation" @keydown.escape.window="close(true)" @resize.window.debounce="onResize()" @keydown="trapFocus($event)" :role="open ? 'dialog' : null" :aria-modal="open ? 'true' : null" :aria-label="open ? 'Site navigation' : null">
    <div class="site-shell header-inner">
        {% include '_components/brand' %}
        <button class="menu-toggle" type="button" x-ref="toggle" @click="toggle()" :aria-expanded="open" aria-controls="main-nav" aria-label="Open navigation" :aria-label="open ? 'Close navigation' : 'Open navigation'"><span x-text="open ? 'Close' : 'Menu'">Menu</span><span class="menu-icon">{% include '_components/icon' with {name: 'menu'} only %}</span><span class="close-icon">{% include '_components/icon' with {name: 'close'} only %}</span></button>
        <div class="header-navigation" id="main-nav" :class="{'is-open': open}" x-ref="panel" @click="if ($event.target.closest('a')) close()">
            <nav aria-label="Main navigation"><a href="{{ url('snippets') }}" {{ craft.app.request.pathInfo == 'snippets' ? 'aria-current="page"'|raw : '' }}>All snippets{% include '_components/icon' only %}</a>{% for category in categories %}<a href="{{ category.url }}" {% if craft.app.request.pathInfo == category.uri %}aria-current="page"{% endif %}>{{ category.title }}{% include '_components/icon' only %}</a>{% endfor %}</nav>
            <form class="site-search" action="{{ url('search') }}" role="search" method="get">
                <label class="sr-only" for="site-search">Search snippets</label>
                <input id="site-search" type="search" name="q" placeholder="Search snippets…" maxlength="200" value="{{ craft.app.request.getQueryParam('q') is iterable ? '' : craft.app.request.getQueryParam('q') }}">
                <button type="submit" aria-label="Search">{% include '_components/icon' with {name: 'search'} only %}</button>
            </form>
        </div>
    </div>
</header>
