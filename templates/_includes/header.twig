    <div class="modal-overlay" id="search_modal" aria-hidden="true" role="dialog" aria-label="Search Modal">
        <div class="modal-content">
            <form class="form form--inline"
                method="post"
                onsubmit="window.location.href='/search?q=' + document.getElementById('search').value; return false;"
            >
                <div class="input">
                    <input id="search" class="search" type="search" placeholder="{{'Enter search term'|t}}" aria-label="Search">
                </div>
                <div class="input">
                    <input type="submit" class="button" value="Submit">
                </div>
            </form>
        </div>
        <button class="close-button" id="modal_close" type="button" aria-label="close">
            &times;
        </button>
