<header role="banner" class="main__header">
    <section class="nav-sub">
        <nav role="navigation" class="navigation container is-open">

            <a class="logo" href="/">
                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="351" height="60" viewBox="0 0 351 60">
                    <defs><style>.cls-1 {font-size: 32px;text-anchor: middle;font-family: "Myriad Pro";font-weight: 700;}.cls-2 {fill: #424141;}</style></defs>
                    <text id="CRAFT_FLEX.GRID" data-name="CRAFT FLEX.GRID" class="cls-1" x="203.019" y="40.121"><tspan x="203.019">CRAFT <tspan class="cls-2">FLEX</tspan>.GRID</tspan></text>
                    <circle cx="30" cy="29" r="28"/>
                    <image id="grid-square-1" data-name="Rechteck 1" x="15" y="18" width="31" height="11" xlink:href="data:img/png;base64,iVBORw0KGgoAAAANSUhEUgAAAB8AAAALCAYAAACH6Va0AAAAI0lEQVQ4jWP8////f4YBAkwDZTHDqOWjlo9aPmo5TQEDAwMAnj0EEvL4Nt0AAAAASUVORK5CYII="/>
                    <image id="grid-square-2" data-name="Rechteck 2" x="15" y="31" width="16" height="9" xlink:href="data:img/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAAHUlEQVQokWP8////fwYKABMlmhlGDRgWBjAwMAAAKEcEDgFqGv8AAAAASUVORK5CYII="/>
                    <image id="grid-square-3" data-name="Rechteck 2 Kopie" x="34" y="31" width="12" height="9" xlink:href="data:img/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAwAAAAJCAYAAAAGuM1UAAAAHElEQVQYlWP8////fwYSABMpihlGNdBEAwMDAwDkugQOeRa12gAAAABJRU5ErkJggg=="/>
                </svg>
            </a>

            <a href="#expand-nav-main-list" class="nav-main-link" aria-controls="nav-main-list" aria-haspopup="true" aria-expanded="true">
                <svg width="30" height="25" class="icon-hamburger" viewBox="0 0 30 25" id="icon-hamburger">
                    <path d="M30 5H0V0h30v5zm0 15H0v5h30v-5zm0-10H0v5h30v-5z"></path>
                </svg>
            </a>

            <ul class="nav-action show-desktop">
                {% set seknav = sekundaerNavigation.shortLinks %}
                {% for page in seknav.all() %}
                <li class="sekundaer__nav--item--level1">
                    <a class="sekundaer__nav--link--level1 {% if craft.app.request.segments|last == page.slug %}active{% endif %}" href="{{ page.url }}">{{ page.title }}</a>
                </li>
                <li><a href="/join" class="button">Klich mich</a></li>
                {% endfor %}
            </ul>
        </nav>
    </section>

    <section class="nav-main">
        <nav role="navigation" class="navigation container">

             {{ mainNavigation | raw }}

            <button id="search_open" class="search-icon" aria-label="Search">
                <svg id="Layer_1" xmlns="http://www.w3.org/2000/svg" width="31.4px" height="30.9px" viewBox="0 0 31.4 30.9">
                    <style>
                        .st0 {
                            fill: #111
                        }
                    </style>
                    <path class="st0" d="M20,22.6c-2.2,1.6-4.9,2.4-7.5,2.4c-2.7,0-5.4-0.9-7.6-2.6c-5.5-4.3-6.6-12-2.4-17.5c2.4-3.1,6-4.9,10-4.9
                        c2.8,0,5.4,0.9,7.5,2.6c2.7,2,4.4,5,4.8,8.2c0.5,3-0.2,6-1.9,8.6l8.5,8.5l-3,3L20,22.6z M12.6,4.2c-4.6,0-8.3,3.7-8.3,8.3
                        c0,4.5,3.7,8.2,8.3,8.2c4.5,0,8.2-3.7,8.2-8.3C20.8,7.9,17.1,4.2,12.6,4.2z"></path>
                </svg>
            </button>
        </nav>
    </section>

    <div class="modal-overlay" id="search_modal" aria-hidden="true" role="dialog" aria-label="Search Modal">
    <div class="modal-content">
        <form class="form form--inline"
            method="post"
            onsubmit="window.location.href='/search?q=' + document.getElementById('search').value; return false;"
        >
            <div class="input">
                <input id="search" class="search" type="search" placeholder="{{'Enter search term'|t}}" aria-label="Search">
            </div>
            <div class="input">
                <input type="submit" class="button" value="Submit">
            </div>
        </form>
    </div>
    <button class="close-button" id="modal_close" type="button" aria-label="close">
        &times;
    </button>
</div> 
</header>

