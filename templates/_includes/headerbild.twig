{% if image|length %}

  {% if image.hasFocalPoint %}
    {% set focalPoint = image.getFocalPoint() %}
    {% set position = focalPoint.x * 100 ~ '% ' ~ focalPoint.y * 100 ~ '%' %}
  {% else %}
    {% set position = 'center center' %}
  {% endif %}

  <style>
  
    .seitenbild__image {
        height: 500px;
        background: url("{{ craft.picture.url(image, 'banner-mobile') }}") no-repeat center;
        background-size: cover;
        background-position: {{ position }};
    }            

    @media (min-width: 768px) {

      .seitenbild__image {
          background: url("{{ craft.picture.url(image, 'banner-tablet') }}") no-repeat center;
          background-size: cover;
          background-position: {{ position }};
      }

    }

    @media (min-width: 1224px) {

        .seitenbild__image {
          background: url("{{ craft.picture.url(image, 'banner-desktop') }}") no-repeat center;
          background-size: cover;
          background-position: {{ position }};
        }

    }

  </style>
  
  <section id="seitenbild-{{ entry.id }}" class="section__seitenbild">
      <div class="container">
          <div class="seitenbild__image"></div>
      </div>
  </section>

{% endif %}
