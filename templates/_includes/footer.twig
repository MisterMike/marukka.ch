{% set footerMetaPages = footerMetaLinks.pageLinks.all() %}
{% set footerLinks = footerPageLinks.pageLinks.all() %}

<footer class="m-footer">

    <div class="l-container l-grid">
        <div class="m-footer__brand">
            <img class="footer__logo" src="{{ siteUrl }}/assets/layout/logo/logo_wg3l_2023_v3_white.svg">
            {# <p><strong>Familienfreundliches</strong> Wohnen</p>#}
        </div>

        <div class="m-footer__address">
            <div class="m-footer__address--wrapper">
                <h2 class="c-footer__address--title">Kontakt</h2>
                <div class="c-footer__address--body">
                    {{kontakt.kontaktanschrift}}
                    <p>
                        <a class="c-footer-menu--link" href="tel:{{kontakt.kontaktTelefon}}" rel="_none">{{kontakt.kontaktTelefon}}</a>
                        <br>
                        {{kontakt.kontaktEMail | encodeEmails}}
                    </p>
                </div>
            </div>
        </div>

        <div class="m-footer__pages">
            <ul class="c-footer-menu--links c-footer--toggle--body">
                {% for page in footerLinks %}
                    <li class="c-footer-menu--item"><a class="c-footer-menu--link" href="{{page.getUrl}}">{{page.title}}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="m-footer__lower">
        <div class="l-container l-grid">
            <div class="c-footer-lower-menu">
                © 2023 {{siteName}}
            </div>
            <div class="c-footer-lower-meta">
                <ul class="c-footer-lower-menu--list">
                    {% for page in footerMetaPages %}
                        <li class="c-footer-menu--item"><a class="c-footer-menu--link" href="{{page.getUrl}}">{{page.title}}</a></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</footer>


