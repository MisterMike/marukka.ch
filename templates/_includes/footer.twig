<footer class="footer">
  <section class="footer__upper">
    <div class="grid__container">
      <div class="content">
        <div class="col-4">
          <div class="footer__contact--box">
            <div class="icon icon-phone"></div>
            <a href="" class="footer__contact--box--link">{{ kontakt.kontaktTelefon }}</a>
          </div>
        </div>
        <div class="col-4">
          <div class="footer__contact--box">
            <div class="icon icon-mail"></div>
            <a href="" class="footer__contact--box--link">{{ kontakt.kontaktEMail }}</a>
          </div>
        </div>
        <div class="col-4">
          <div class="footer__contact--box">
            <div class="icon icon-location"></div>
            <a href="https://www.google.ch/maps/dir/''/" class="footer__contact--box--link">{{ kontakt.kontaktLocation }}</a>
          </div>
        </div>
      </div>

      <div class="content">
        <div class="footer__content--wrapper">
          <div class="col-3">
            <div class="footer__content--box">
              <h4 class="footer__title">Kontakt</h4>
              <address class="footer__address">
                {{ kontakt.kontaktAdresse|nl2br }}
              </address>
            </div>
          </div>
          <div class="col-3">
            <div class="footer__content--box">
              {#                            <h4 class="footer__title">Firma</h4>#}
              {#                            <ul class="navigation__list navigation__list--footer">#}
              {#                                <li class="navigation__element navigation__element--footer" >#}
              {#                                    <a class="navigation__link navigation__link--footer" href="de/memberlogin">Mitarbeiter Login</a>#}
              {#                                </li>#}
              {#                            </ul>#}
            </div>
          </div>
          <div class="col-3">
            <div class="footer__content--box">
              <h4 class="footer__title">Weitere Informationen</h4>
              <ul class="navigation__list navigation__list--footer">
                {% for page in footerLinks.shortLinks.all() %}
                  <li class="navigation__element navigation__element--footer" >
                    <a class="navigation__link navigation__link--footer" href="{{ page.url }}">{{ page.title }}</a>
                  </li>
                {% endfor %}

              </ul>
            </div>
          </div>
          <div class="col-3">
            <div class="footer__content--box">
              <h4 class="footer__title">Newsletter</h4>
              <form class="footer-newsletter" action=""><input type="email" name="email" placeholder="E-Mail Adresse"></form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="footer__lower">
    <div class="grid__container">
      <div class="content">
        <div class="footer__lower--social">
          <ul class="footer__lower--social--links">
            <li class="footer__lower--social--link "><a href="#" class="icon icon-facebook"></a></li>
            <li class="footer__lower--social--link "><a href="#" class="icon icon-pinterest"></a></li>
            <li class="footer__lower--social--link "><a href="#" class="icon icon-twitter"></a></li>
            <li class="footer__lower--social--link "><a href="#" class="icon icon-instagram"></a></li>
          </ul>
          <div class="footer__lower--copyright">
            &copy; {{ now | date('Y') }} | {{ siteName }}
          </div>
        </div>
      </div>
    </div>
  </section>
</footer>

