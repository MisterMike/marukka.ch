{% macro recursive_nav(entries, cssClass, depth, wrapUl) %}

  {% import _self as self %}

  {% if wrapUl %}
    <ul class="{{ cssClass }}__nav--items--level{{ depth }}">
  {% endif %}
      
  {% for entry in entries.all() %}

      {% if entry.nichtInNavigationAnzeigen == false %}

        {% switch entry.type %}

          {% default %}
      
      <li class="{{ cssClass }}__nav--item--level{{ depth }} {% if entry.hasDescendants %}has--children{% endif %}">
            
            {% if entry.hasDescendants %}
            
              {% if depth != '3' %}

                <span class="button__open--level button__open--level{% if depth == '1' %}-2{% else %}-3{% endif %}"></span>

              {% endif %}
            
            {% endif %}
            
            <a href="{{ entry.url }}" class="{{ cssClass }}__nav--link--level{{ depth }}">{{ entry.title }}</a>
            
            {% if entry.hasDescendants %}
            
              {{ self.recursive_nav(entry.children, cssClass, depth+1, true) }}
            
            {% endif %}
            
          </li>
      
        {% endswitch %}

      {% endif %}

  {% endfor %}
      
  {% if wrapUl %}
    </ul>
  {% endif %}

{% endmacro %} 

{% import _self as self %}

<ul class="{{ cssClass }}__nav--items--level1">

  {% set navEntries = craft.entries.section(sectionName ?? entry.section).level(1) %}
  {{ self.recursive_nav(navEntries,(cssClass == "" ? entry.section : cssClass ), 1, false)  }}

</ul>