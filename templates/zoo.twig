{% set entry = craft.entries().id(276).one() %}

{% set block = entry.inhaltMatrix
  .type('bildergalerie')
  .one() %}

{% set images = block.bilder.all() %}

{# Register engadin pswp junk js: #}
{% js "/assets/js/667.chunk.js" %}

{% extends "_layouts/base" %}

{% block content %}

    <main class="main" id="mainView">

        <article id="mainContent"><!-- Template: {{ _self }}.twig -->

            <div is="StageDetailPageModule" inline-template :images='[{% for image in images %}{"src":"{{image.url()}}","title":"{{image.title}}", "w":{{image.width}}, "h":{{image.height}} },{% endfor %}]'>
                <div class="m-stage m-stage-detail-page m-stage-detail-page--multiple-images">
                    
                    {% for image in images %}
                        
                    

                    <div class="m-stage-detail-page__image" @click="showPhotoSwipe({{loop.index0}})">
                        <div class="c-image" itemscope itemtype="http://schema.org/ImageObject">
                            <picture class="c-image__image">
                                <source media="all and (min-width: 1200px)" data-srcset="{{image.getUrl({ width: 690, height: 690 , format: 'jpeg'})}} 1x, {{image.getUrl({ width: 690, height: 690 , format: 'jpeg'})}} 1.5x" type="image/jpeg">
{#                                 <source media="all and (min-width: 768px)" data-srcset="/sites/all/files/styles/hero_detailpage_medium/shared/discover.swiss/images/img_4kq_jiccbib.jpg?h=50844e28&amp;itok=Rz1VJKCz 1x, /sites/all/files/styles/hero_detailpage_medium_2x/shared/discover.swiss/images/img_4kq_jiccbib.jpg?h=50844e28&amp;itok=AQQ8y2PK 1.5x" type="image/jpeg">
                                <source media="all and (min-width: 320px)" data-srcset="/sites/all/files/styles/hero_detailpage_small/shared/discover.swiss/images/img_4kq_jiccbib.jpg?h=50844e28&amp;itok=-0uM0l0N 1x, /sites/all/files/styles/hero_detailpage_small_2x/shared/discover.swiss/images/img_4kq_jiccbib.jpg?h=50844e28&amp;itok=sDbe5Ulq 1.5x" type="image/jpeg"> #}
                                <img class="img lazy" loading="lazy" data-src="{{image.getUrl({ width: 690, height: 690 , format: 'jpeg'})}}" title="{{image.title}}" alt="{{image.title}}" itemprop="contentUrl" width="100%" height="100%"/>
                            </picture>
                        </div>
                    </div>

                    {% endfor %}

                    <photo-swipe :is-open="isOpen" :items="items" :options="options" @close="hidePhotoSwipe"></photo-swipe>
                </div>
            </div>

        </article>
    </main>

{% endblock %}
