{% set image = entry.hero.one() %}


{% extends "_layouts/base" %}

{% block content %}

    <main class="main" id="mainView">

        <article id="mainContent"><!-- Template: {{ _self }}.twig -->

            {% if image is defined and image|length %}
            <div class="m-hero m-hero-boxed">
                <div class="m-hero-boxed__image">
                    <div class="c-image c-image--center-middle" itemscope itemtype="http://schema.org/ImageObject">
                        <picture class="c-image__image">
                            <source media="all and (min-width: 1200px)" data-srcset="{{ image.getUrl({ width: 1310, height:873, format: 'webp' }) }} 1x, {{ image.getUrl({ width: 1965, height:1310, format: 'webp' }) }} 1.5x" type="image/webp">
                            <source media="all and (min-width: 768px)" data-srcset="{{ image.getUrl({ width: 980, height:654, format: 'webp' }) }} 1x, {{ image.getUrl({ width: 1470, height:981, format: 'webp' }) }} 1.5x" type="image/webp">
                            <source media="all and (min-width: 320px)" data-srcset="{{ image.getUrl({ width: 480, height:480, format: 'webp' }) }} 1x, {{ image.getUrl({ width: 720, height:720, format: 'webp' }) }} 1.5x" type="image/webp">
                            <source data-srcset="{{ image.getUrl({ width: 480, height:480, format: 'webp' }) }} 1x" type="image/webp">
                            <source media="all and (min-width: 1200px)" data-srcset="{{ image.getUrl({ width: 1310, height:873, format: 'jpg' }) }} 1x, {{ image.getUrl({ width: 1965, height:1310, format: 'webp' }) }} 1.5x" type="image/jpeg">
                            <source media="all and (min-width: 768px)" data-srcset="{{ image.getUrl({ width: 980, height:654, format: 'jpg' }) }} 1x, {{ image.getUrl({ width: 1470, height:981, format: 'webp' }) }} 1.5x" type="image/jpeg">
                            <source media="all and (min-width: 320px)" data-srcset="{{ image.getUrl({ width: 480, height:480, format: 'jpg' }) }} 1x, {{ image.getUrl({ width: 720, height:720, format: 'webp' }) }} 1.5x" type="image/jpeg">
                            <source data-srcset="{{ image.getUrl({ width: 480, height:480, format: 'jpg' }) }} 1x" type="image/jpeg">
                            <img class="img lazy" loading="lazy" data-src="{{ image.getUrl({ width: 480, height:480, format: 'jpg' }) }}" title="{{image.title}}" alt="{{image.assetAltText|default(image.title)}}" itemprop="contentUrl" width="100%" height="100%"/>
                        </picture>
        {#                 <div class="c-image__caption">
                            <a href="#" class="c-image__caption-link">
                                 Author, Credits, Bildrechte 
                                <svg class="icon icon--poi ">
                                    <use xlink:href="/icons/sprites.svg#poi"></use>
                                </svg>
                            </a>
                        </div> #}
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="l-container l-grid">
                <div class="c-headline h2-alike c-headline--centered">
                    <div class="c-headline__wrapper">
                        {% if entry.parent().title is defined %}
                        <p class="c-headline__preline">
                            <span class="c-headline__preline-content">{{entry.parent().title}}</span>
                        </p>
                        {% endif %}
                        <h1 class="c-headline__title h2">{{entry.title}}</h1>
                    </div>
                </div>
            </div>

            {% if entry.lead is defined and entry.lead|length > 0 %}
                {%- include "_components/lead" -%}
            {% endif %}
        

        {%- include "_routers/component" with { blocks: entry.inhaltMatrix.all() } -%}

    </article>
</main>

{% endblock %}
