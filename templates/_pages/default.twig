{% extends '_layouts/base' %}
{% block content %}<article class="site-shell"><header class="article-header"><h1>{{ entry.title }}</h1>{% if entry.lead ?? false %}<p class="article-lead">{{ entry.lead }}</p>{% endif %}</header><div class="article-content">{% if entry.contentMatrix is defined %}{% include '_routers/component' with {components: entry.contentMatrix.with(['image']).all()} only %}{% endif %}</div></article>{% endblock %}